{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT u.id, u.username, u.profile_picture_url, u.created_at, u.updated_at\n            FROM users u\n            WHERE u.id IN (\n                SELECT u2.id\n                FROM users u2\n                LEFT JOIN user_emails ue ON ue.user_id = u2.id\n                WHERE u2.username % $1\n                   OR ue.email % $1\n            )\n            ORDER BY similarity(u.username, $1) DESC\n            LIMIT $2 OFFSET $3\n            ",

{
    "openapi": "3.0.0",
    "info": {
        "title": "Generated by cue.",
        "version": "no version"
    },
    "paths": {},
    "components": {
        "schemas": {
            "Commands": {
                "type": "object",
                "properties": {
                    "validate": {
                        "type": "object",
                        "required": [
                            "description",
                            "input",
                            "output"
                        ],
                        "properties": {
                            "description": {
                                "type": "string",
                                "enum": [
                                    "Validate the spec"
                                ]
                            },
                            "input": {
                                "type": "object"
                            },
                            "output": {
                                "type": "object",
                                "required": [
                                    "valid",
                                    "errors"
                                ],
                                "properties": {
                                    "valid": {
                                        "type": "boolean"
                                    },
                                    "errors": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ForestCommands"
                    },
                    {
                        "required": [
                            "validate"
                        ]
                    }
                ]
            },
            "DeploymentHooks": {
                "description": "#DeploymentHooks defines the hook signatures for the deployment contract.\nComponents implementing this contract must provide all three hooks.",
                "type": "object",
                "properties": {
                    "prepare": {
                        "type": "object",
                        "required": [
                            "description",
                            "input",
                            "output"
                        ],
                        "properties": {
                            "description": {
                                "type": "string",
                                "default": "Prepare deployment artifacts"
                            },
                            "input": {
                                "type": "object"
                            },
                            "output": {
                                "type": "object",
                                "required": [
                                    "manifests"
                                ],
                                "properties": {
                                    "manifests": {
                                        "type": "array",
                                        "items": {
                                            "$ref": "#/components/schemas/Manifest"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "release": {
                        "type": "object",
                        "required": [
                            "description",
                            "input",
                            "output"
                        ],
                        "properties": {
                            "description": {
                                "type": "string",
                                "default": "Execute deployment"
                            },
                            "input": {
                                "type": "object",
                                "required": [
                                    "release_id"
                                ],
                                "properties": {
                                    "release_id": {
                                        "type": "string"
                                    }
                                }
                            },
                            "output": {
                                "type": "object"
                            }
                        }
                    },
                    "rollback": {
                        "type": "object",
                        "required": [
                            "description",
                            "input"
                        ],
                        "properties": {
                            "description": {
                                "type": "string",
                                "default": "Roll back deployment"
                            },
                            "input": {
                                "type": "object",
                                "required": [
                                    "release_id",
                                    "target_revision"
                                ],
                                "properties": {
                                    "release_id": {
                                        "type": "string"
                                    },
                                    "target_revision": {
                                        "type": "string",
                                        "default": ""
                                    }
                                }
                            }
                        }
                    }
                },
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ForestHook"
                    },
                    {
                        "required": [
                            "prepare",
                            "release",
                            "rollback"
                        ]
                    }
                ]
            },
            "ForestCommand": {
                "type": "object",
                "required": [
                    "description",
                    "input",
                    "output"
                ],
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "input": {
                        "type": "object"
                    },
                    "output": {
                        "type": "object"
                    }
                }
            },
            "ForestCommands": {
                "type": "object",
                "additionalProperties": {
                    "$ref": "#/components/schemas/ForestCommand"
                }
            },
            "ForestHook": {
                "type": "object"
            },
            "ForestHooks": {
                "type": "object",
                "additionalProperties": {
                    "$ref": "#/components/schemas/ForestHook"
                }
            },
            "ForestSpec": {
                "type": "object"
            },
            "Hooks": {
                "type": "object",
                "properties": {
                    "forest/deployment": {
                        "type": "object",
                        "properties": {
                            "prepare": {
                                "type": "object",
                                "required": [
                                    "description"
                                ],
                                "properties": {
                                    "description": {
                                        "type": "string",
                                        "enum": [
                                            "Validate the spec and render the function's Terraform"
                                        ]
                                    }
                                }
                            },
                            "release": {
                                "type": "object",
                                "required": [
                                    "description"
                                ],
                                "properties": {
                                    "description": {
                                        "type": "string",
                                        "enum": [
                                            "Apply the function's Terraform"
                                        ]
                                    }
                                }
                            },
                            "rollback": {
                                "type": "object",
                                "required": [
                                    "description"
                                ],
                                "properties": {
                                    "description": {
                                        "type": "string",
                                        "enum": [
                                            "Roll back to a previous revision"
                                        ]
                                    }
                                }
                            }
                        },
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/DeploymentHooks"
                            },
                            {
                                "required": [
                                    "prepare",
                                    "release",
                                    "rollback"
                                ]
                            }
                        ]
                    }
                },
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ForestHooks"
                    },
                    {
                        "required": [
                            "forest/deployment"
                        ]
                    }
                ]
            },
            "Http": {
                "type": "object",
                "required": [
                    "api",
                    "routes"
                ],
                "properties": {
                    "api": {
                        "description": "An existing API Gateway v2 HTTP API in the account, found by name.",
                        "type": "string",
                        "default": "understory-internal-api"
                    },
                    "routes": {
                        "description": "Route keys, e.g. \"ANY /rpcapi.inter.v1.DeferredMessagesService/{proxy+}\".\n\nA route key is unique per API, and the API is shared with every other\nstate that attaches to it \u2014 so two states declaring the same key is a\ncollision this component cannot see. A parallel copy of a service must\nnot repeat the original's routes.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "Image": {
                "type": "object",
                "required": [
                    "repository",
                    "tag"
                ],
                "properties": {
                    "repository": {
                        "description": "A bare repository name (\"deferred-messages\") resolves against the\nshared ECR registry \u2014 destination metadata `image_registry`, defaulting\nto the shared account's registry. Anything containing a \"/\" is used\nverbatim.\n\nThat is the whole answer to \"where does the ECR URL come from\": it is a\ndeterministic function of the registry and the repository name, so\nthere is nothing to look up in another workspace's state.",
                        "type": "string"
                    },
                    "tag": {
                        "description": "Deliberately NO default. Inject it at release time with the immutable\ncommit tag CI already pushes (`:<git sha>`):\n\n  forest release create --set understory/lambda.image.tag=$GITHUB_SHA\n\nA moving tag (`dev-latest`) is refused by `validate`. Lambda resolves a\ntag to a digest once, when the function is updated, so with a moving tag\nthe plan never shows a change, the function never moves, and the only\nthing that ever deploys code is an out-of-band `update-function-code`\nthat Terraform then cannot see. A value starting `sha256:` is used as a\ndigest.",
                        "type": "string"
                    }
                }
            },
            "Manifest": {
                "description": "#Manifest is a named output file produced by a deployment hook.",
                "type": "object",
                "required": [
                    "name",
                    "content"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    },
                    "content": {
                        "type": "string"
                    }
                }
            },
            "Otel": {
                "type": "object",
                "required": [
                    "enabled",
                    "collector"
                ],
                "properties": {
                    "enabled": {
                        "description": "The same variables infrastructure-core's `otel-env` module produces.",
                        "type": "boolean",
                        "default": true
                    },
                    "collector": {
                        "description": "\"extension\" (the collector layer baked into the image) or \"remote\".",
                        "type": "string",
                        "default": "extension"
                    }
                }
            },
            "Queue": {
                "type": "object",
                "required": [
                    "enabled",
                    "batch_size",
                    "batching_window_seconds",
                    "max_concurrency",
                    "max_receive_count",
                    "visibility_timeout_seconds",
                    "delay_seconds",
                    "report_batch_item_failures",
                    "subscriptions"
                ],
                "properties": {
                    "enabled": {
                        "description": "The function's own queue and dead-letter queue, named\n`<environment>-<name>` and `<environment>-<name>-dlq` \u2014 the names\ninfrastructure-core's `sqs` and `lambda-sqs` modules use, on purpose.",
                        "type": "boolean",
                        "default": false
                    },
                    "batch_size": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000,
                        "default": 10
                    },
                    "batching_window_seconds": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 300,
                        "default": 0
                    },
                    "max_concurrency": {
                        "description": "0 means unset (no scaling_config). AWS's floor is 2, checked in validate.",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000,
                        "default": 0
                    },
                    "max_receive_count": {
                        "description": "Deliveries before a message moves to the DLQ.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000,
                        "default": 4
                    },
                    "visibility_timeout_seconds": {
                        "description": "0 means \"the function's timeout\", which is what lambda-sqs does. AWS\nrefuses an event source mapping whose queue times out sooner than the\nfunction, so an explicit value below `timeout` fails validate.",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 43200,
                        "default": 0
                    },
                    "delay_seconds": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 900,
                        "default": 0
                    },
                    "report_batch_item_failures": {
                        "description": "Partial batch responses. Also sets\nHOLDBAR_REPORT_BATCH_ITEM_FAILURES_SQS_ENABLED=true, exactly as\necr-lambda does, because go-aws's ulambda reads it.",
                        "type": "boolean",
                        "default": true
                    },
                    "subscriptions": {
                        "description": "SNS topics that publish into the queue. The single most common event\nsource in infrastructure-core (~35 of its lambda files).",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Subscription"
                        }
                    }
                }
            },
            "Scheduler": {
                "type": "object",
                "required": [
                    "enabled"
                ],
                "properties": {
                    "enabled": {
                        "description": "An EventBridge Scheduler group named after the function, a role the\nscheduler assumes to deliver into this function's own queue, and the\ngrants for the function to manage schedules in that group and pass that\nrole. Requires queue.enabled \u2014 the queue is the target.\n\nThis is the deferred-messages / crowdin-sync shape: the function writes\nschedules at runtime. A fixed cron is a different thing and not here yet.",
                        "type": "boolean",
                        "default": false
                    }
                }
            },
            "Spec": {
                "type": "object",
                "properties": {
                    "name": {
                        "description": "The function's name, and the stem of every other name \u2014 role, queue,\nlog group, scheduler group. Up to 43 characters: the longest derived\nname is `<name>-eventbridge-iam-role`, and IAM stops at 64.",
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "domain": {
                        "description": "OTEL service.namespace and DOMAIN_NAME, e.g. \"developer-platform\".",
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                    },
                    "image": {
                        "$ref": "#/components/schemas/Image"
                    },
                    "architecture": {
                        "description": "\"arm64\" or \"x86_64\".",
                        "type": "string",
                        "default": "arm64"
                    },
                    "memory": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 10240,
                        "default": 128
                    },
                    "timeout": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 900,
                        "default": 30
                    },
                    "ephemeral_storage": {
                        "type": "integer",
                        "minimum": 512,
                        "maximum": 10240,
                        "default": 512
                    },
                    "reserved_concurrency": {
                        "description": "-1 means unreserved.",
                        "type": "integer",
                        "minimum": -1,
                        "default": -1
                    },
                    "log_retention_days": {
                        "description": "0 means the environment's default: 365 in production, 90 elsewhere.",
                        "type": "integer",
                        "minimum": 0,
                        "default": 0
                    },
                    "variables": {
                        "description": "Plain environment variables. Templated.",
                        "type": "object",
                        "oneOf": [
                            {
                                "allOf": [
                                    {
                                        "additionalProperties": {
                                            "type": "string"
                                        }
                                    },
                                    {
                                        "not": {
                                            "anyOf": [
                                                {}
                                            ]
                                        }
                                    }
                                ]
                            },
                            {
                                "not": {
                                    "anyOf": [
                                        {
                                            "additionalProperties": {
                                                "type": "string"
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    "secrets": {
                        "description": "Secrets Manager secret names the function may read. Templated, and a\ntrailing `*` grants a prefix. Only IAM: the function still loads them\nitself, which is how every Go service here already works.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "permissions": {
                        "description": "Extra IAM statements for the function's role. Templated resources.",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Statement"
                        }
                    },
                    "queue": {
                        "$ref": "#/components/schemas/Queue"
                    },
                    "scheduler": {
                        "$ref": "#/components/schemas/Scheduler"
                    },
                    "http": {
                        "$ref": "#/components/schemas/Http"
                    },
                    "otel": {
                        "$ref": "#/components/schemas/Otel"
                    }
                },
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ForestSpec"
                    },
                    {
                        "required": [
                            "name",
                            "domain",
                            "image",
                            "architecture",
                            "memory",
                            "timeout",
                            "ephemeral_storage",
                            "reserved_concurrency",
                            "log_retention_days",
                            "variables",
                            "secrets",
                            "permissions",
                            "queue",
                            "scheduler",
                            "http",
                            "otel"
                        ]
                    }
                ]
            },
            "Statement": {
                "type": "object",
                "required": [
                    "actions",
                    "resources"
                ],
                "properties": {
                    "actions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "resources": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "Subscription": {
                "type": "object",
                "required": [
                    "topic_arn",
                    "filter_policy",
                    "filter_policy_scope",
                    "raw_message_delivery"
                ],
                "properties": {
                    "topic_arn": {
                        "description": "Templated, so `arn:aws:sns:{{region}}:{{account_id}}:<topic>` works in\nevery environment without a per-env override.",
                        "type": "string"
                    },
                    "filter_policy": {
                        "type": "string",
                        "default": ""
                    },
                    "filter_policy_scope": {
                        "type": "string",
                        "default": "MessageAttributes"
                    },
                    "raw_message_delivery": {
                        "type": "boolean",
                        "default": true
                    }
                }
            }
        }
    }
}

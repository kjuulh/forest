  "query": "\n            SELECT\n                last_seen_at,\n                stopped_at,\n                last_seen_at > now() - make_interval(secs => $2::double precision) AS \"alive!\",\n                last_seen_at > now() - make_interval(secs => $3::double precision) AS \"heard!\"\n            FROM forest_replicas\n            WHERE name = $1\n        ",

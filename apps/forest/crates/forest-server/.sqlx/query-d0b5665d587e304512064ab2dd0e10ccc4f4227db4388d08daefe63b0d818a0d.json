  "query": "\n            UPDATE oauth_authorization_codes\n            SET consumed_at = now()\n            WHERE code_hash = $1 AND consumed_at IS NULL AND expires_at > now()\n            RETURNING app_id, user_id, redirect_uri, scopes,\n                      code_challenge, code_challenge_method, nonce\n            ",

{# ── Project settings shell ──────────────────────────────────────────
   The shared chrome for everything under
   `/orgs/{org}/projects/{project}/settings`.

   Triggers, Policies and Pipelines used to be three standalone pages
   reached only by typing the URL: no shared sub-nav, no project header,
   and — the reported gap — no way back to the project. This macro is the
   one place that chrome lives, so every section (and every *_edit page
   hanging off one) gets the same breadcrumb, the same Back affordance and
   the same sub-nav for free.

   Deliberately dumb about content: it renders the frame and calls back
   for the body, so the sections keep owning their own rows, forms and
   empty states. Adding a fourth section is one entry in SECTIONS below.

   Usage:
     {% from "components/project_settings.html.jinja" import project_settings_layout %}
     {% call project_settings_layout(current_org, current_project, "triggers",
                                     "Triggers", "Automatically release …") %}
       …rows / forms…
     {% endcall %}

   `crumb` is for the pages that sit one level below a section — the
   trigger/policy edit forms. Passing it appends a final breadcrumb item
   and re-points Back at the section instead of the project, so "back"
   always means "the place I came from".
#}

{% set SECTIONS = [
    {"slug": "triggers",  "label": "Triggers"},
    {"slug": "policies",  "label": "Policies"},
    {"slug": "pipelines", "label": "Pipelines"},
] %}

{# ── Sub-navigation ───────────────────────────────────────────────────
   Two renderings of the same list: a sidebar on md+ (matching the org
   settings sidebar, so the two settings areas feel like one idea), and a
   horizontally scrollable pill row below that. The org sidebar simply
   disappears on mobile; this one must not, or small screens get the
   dead-end back again. #}
{% macro project_settings_nav(org_name, project_name, active_section) %}
<nav class="w-48 shrink-0 hidden md:block" aria-label="Project settings sections">
    <ul class="space-y-0.5">
        {% for section in SECTIONS %}
        <li>
            <a href="/orgs/{{ org_name }}/projects/{{ project_name }}/settings/{{ section.slug }}"{% if section.slug == active_section %} aria-current="page"{% endif %} class="block px-3 py-1.5 text-sm rounded-md {% if section.slug == active_section %}bg-gray-100 text-gray-900 font-medium{% else %}text-gray-600 hover:text-gray-900 hover:bg-gray-50{% endif %}">{{ section.label }}</a>
        </li>
        {% endfor %}
    </ul>
</nav>
{%- endmacro %}

{% macro project_settings_nav_mobile(org_name, project_name, active_section) %}
<nav class="md:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-none" aria-label="Project settings sections">
    <ul class="flex gap-1.5 w-max">
        {% for section in SECTIONS %}
        <li>
            <a href="/orgs/{{ org_name }}/projects/{{ project_name }}/settings/{{ section.slug }}"{% if section.slug == active_section %} aria-current="page"{% endif %} class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border {% if section.slug == active_section %}bg-gray-100 border-gray-300 text-gray-900 font-medium{% else %}border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50{% endif %}">{{ section.label }}</a>
        </li>
        {% endfor %}
    </ul>
</nav>
{%- endmacro %}

{# ── Breadcrumb + back ────────────────────────────────────────────────
   `Org › Project › Settings › Section [› crumb]`. Every item but the last
   is a link, so the breadcrumb is itself a way out; the explicit Back
   link next to it is the one-click version of the same move. #}
{% macro project_settings_breadcrumb(org_name, project_name, active_section, section_title, crumb="") %}
{% set back_label = section_title if crumb else project_name %}
<div class="flex items-center justify-between gap-4 flex-wrap mb-4">
    <nav class="flex items-center gap-1.5 text-sm text-gray-500 min-w-0 flex-wrap" aria-label="Breadcrumb">
        <a href="/orgs/{{ org_name }}/projects" class="hover:text-gray-900 hover:underline">{{ org_name }}</a>
        <span class="text-gray-300" aria-hidden="true">&rsaquo;</span>
        <a href="/orgs/{{ org_name }}/projects/{{ project_name }}" class="hover:text-gray-900 hover:underline">{{ project_name }}</a>
        <span class="text-gray-300" aria-hidden="true">&rsaquo;</span>
        <a href="/orgs/{{ org_name }}/projects/{{ project_name }}/settings" class="hover:text-gray-900 hover:underline">Settings</a>
        <span class="text-gray-300" aria-hidden="true">&rsaquo;</span>
        {% if crumb %}
        <a href="/orgs/{{ org_name }}/projects/{{ project_name }}/settings/{{ active_section }}" class="hover:text-gray-900 hover:underline">{{ section_title }}</a>
        <span class="text-gray-300" aria-hidden="true">&rsaquo;</span>
        <span class="text-gray-900 truncate">{{ crumb }}</span>
        {% else %}
        <span class="text-gray-900">{{ section_title }}</span>
        {% endif %}
    </nav>
    <a href="/orgs/{{ org_name }}/projects/{{ project_name }}{% if crumb %}/settings/{{ active_section }}{% endif %}" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-900 shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Back to {{ back_label }}
    </a>
</div>
{%- endmacro %}

{# ── The layout ───────────────────────────────────────────────────────
   Project header (org / project, mono, mirroring project_detail's) so you
   always know which project you are configuring, then the sub-nav beside
   the caller's content. #}
{% macro project_settings_layout(org_name, project_name, active_section, section_title, section_description="", crumb="") %}
{# `max-w-6xl` rather than `app-container` (56rem): the sidebar eats 14rem
   of the track, and the trigger/policy rows — name, pattern chips and three
   action buttons on one line — are already tight at the standard width.
   6xl is the nav's own width, so the header lines up with the `forest`
   logo above it and the content column ends up marginally wider than it
   was as a standalone page, never narrower. #}
<section class="max-w-6xl mx-auto px-4 pt-10">
    {{ project_settings_breadcrumb(org_name, project_name, active_section, section_title, crumb) }}

    <div class="mb-8">
        <h1 class="font-mono text-2xl tracking-tight leading-tight">
            <span class="text-gray-500">{{ org_name }}</span><span class="text-gray-300 mx-0.5">/</span><span class="font-bold text-gray-900">{{ project_name }}</span><span class="text-gray-400 font-sans text-base font-normal ml-2">Settings</span>
        </h1>
        <p class="text-sm text-gray-500 mt-1">Release configuration for this project — triggers, policies and pipelines.</p>
    </div>

    {{ project_settings_nav_mobile(org_name, project_name, active_section) }}

    <div class="flex gap-8">
        {{ project_settings_nav(org_name, project_name, active_section) }}
        <div class="flex-1 min-w-0">
            <div class="mb-6">
                <h2 class="text-lg font-bold">{{ crumb if crumb else section_title }}</h2>
                {% if section_description %}
                <p class="text-sm text-gray-500 mt-1">{{ section_description }}</p>
                {% endif %}
            </div>
            {{ caller() }}
        </div>
    </div>
</section>
{%- endmacro %}

{% extends "base.html.jinja" %}
{% from "components/settings_sidebar.html.jinja" import settings_layout %}
{% from "components/visibility.html.jinja" import visibility_state, read_only_note, visibility_form, admin_only_note %}

{% block content %}
{% call settings_layout(org_name, "visibility") %}
    <div class="space-y-6 max-w-2xl">
        <div>
            <h2 class="text-lg font-bold mb-1">Visibility</h2>
            <p class="text-sm text-gray-500">Who outside {{ org_name }} can read the components it publishes.</p>
        </div>

        {% if flash_error %}
        <div role="alert" class="p-3 rounded-md bg-red-50 border border-red-200 text-sm text-red-800">{{ flash_error }}</div>
        {% endif %}

        <div class="p-4 border border-gray-200 rounded-lg space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">Organisation</span>
                {{ visibility_state(org_public) }}
            </div>
            {% if org_public %}
            <p class="text-sm text-gray-700">Every component {{ org_name }} publishes, now and later, is visible to anyone, even without signing in, and usable by anyone signed in, whatever each component's own setting says.</p>
            {% else %}
            <p class="text-sm text-gray-700">Only members can read {{ org_name }}'s components, except components that are made public one by one in their project settings.</p>
            {% endif %}
        </div>

        {{ read_only_note() }}

        {% if can_change %}
        {{ visibility_form(org_name, "", csrf_token, org_public) }}
        {% else %}
        {{ admin_only_note() }}
        {% endif %}
    </div>
{% endcall %}
{% endblock %}

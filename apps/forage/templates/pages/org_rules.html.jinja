{% extends "base.html.jinja" %}

{% block content %}
<section class="app-container pt-12">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold">Organisation Rules</h1>
            <p class="text-sm text-gray-500 mt-1">
                {{ current_org }} &middot; Apply policies, triggers, and pipelines across matching projects.
            </p>
        </div>
    </div>

    {% if rules | length > 0 %}
    <div class="space-y-4 mb-8">
        {% for rule in rules %}
        <div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
            <div class="px-4 py-3 flex items-start gap-3 flex-wrap border-b border-gray-100">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                    {% if rule.enabled %}
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-green-500 shrink-0" title="Enabled"></span>
                    {% else %}
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-gray-300 shrink-0" title="Disabled"></span>
                    {% endif %}
                    <div class="min-w-0">
                        <h2 class="font-semibold truncate">{{ rule.name }}</h2>
                        <p class="text-xs text-gray-500">
                            {{ rule.policy_count }} policies · {{ rule.trigger_count }} triggers · {{ rule.pipeline_count }} pipelines
                        </p>
                    </div>
                </div>
                {% if is_admin %}
                <form method="POST" action="/orgs/{{ current_org }}/rules/{{ rule.name }}/delete" onsubmit="return confirm('Delete organisation rule set {{ rule.name }}?');">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="text-sm text-red-600 hover:text-red-700">Delete</button>
                </form>
                {% endif %}
            </div>
            <div class="p-4 grid gap-4 lg:grid-cols-2">
                <div>
                    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Project selector</h3>
                    <div class="space-y-2 text-sm">
                        {% if rule.name_regex %}<div><span class="text-gray-500">Name regex:</span> <code>{{ rule.name_regex }}</code></div>{% endif %}
                        {% if rule.tags | length > 0 %}
                        <div><span class="text-gray-500">Tags:</span>
                            {% for tag in rule.tags %}<code class="ml-1 px-1 py-0.5 bg-gray-100 rounded">{{ tag }}</code>{% endfor %}
                        </div>
                        {% endif %}
                        {% if rule.include_projects | length > 0 %}
                        <div><span class="text-gray-500">Include:</span> {{ rule.include_projects | join(", ") }}</div>
                        {% endif %}
                        {% if rule.exclude_projects | length > 0 %}
                        <div><span class="text-gray-500">Exclude:</span> {{ rule.exclude_projects | join(", ") }}</div>
                        {% endif %}
                        {% if rule.metadata_match | length > 0 %}
                        <div><span class="text-gray-500">Metadata:</span>
                            {% for pair in rule.metadata_match %}<code class="ml-1 px-1 py-0.5 bg-gray-100 rounded">{{ pair.key }}={{ pair.value }}</code>{% endfor %}
                        </div>
                        {% endif %}
                        {% if not rule.name_regex and rule.tags | length == 0 and rule.include_projects | length == 0 and rule.metadata_match | length == 0 %}
                        <div class="text-gray-500">All projects in this organisation.</div>
                        {% endif %}
                    </div>
                </div>
                <details class="text-sm">
                    <summary class="cursor-pointer font-medium">Rule payload</summary>
                    <div class="mt-3 space-y-3">
                        <div>
                            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Policies</div>
                            <pre class="overflow-x-auto rounded bg-gray-950 text-gray-100 p-3 text-xs">{{ rule.policies_json }}</pre>
                        </div>
                        <div>
                            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Triggers</div>
                            <pre class="overflow-x-auto rounded bg-gray-950 text-gray-100 p-3 text-xs">{{ rule.triggers_json }}</pre>
                        </div>
                        <div>
                            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Pipelines</div>
                            <pre class="overflow-x-auto rounded bg-gray-950 text-gray-100 p-3 text-xs">{{ rule.pipelines_json }}</pre>
                        </div>
                    </div>
                </details>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="border border-dashed border-gray-300 rounded-lg p-8 text-center mb-8 bg-white">
        <h2 class="font-semibold mb-1">No organisation rules yet</h2>
        <p class="text-sm text-gray-500">Create a rule set to manage cross-project defaults from one place.</p>
    </div>
    {% endif %}

    {% if is_admin %}
    <div class="border border-gray-200 rounded-lg p-5 bg-white">
        <h2 class="font-semibold mb-1">Create rule set</h2>
        <p class="text-sm text-gray-500 mb-5">Selectors are additive: exact project names, metadata, tags, and a project-name regex all narrow the matching set. Leave selectors empty to target every project.</p>
        <form method="POST" action="/orgs/{{ current_org }}/rules" class="space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                    <span class="text-sm font-medium">Name</span>
                    <input name="name" required class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="default-release-rules">
                </label>
                <label class="flex items-end gap-2 text-sm">
                    <input type="checkbox" name="enabled" checked class="rounded border-gray-300">
                    Enabled
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Include projects</span>
                    <textarea name="include_projects" rows="2" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="api, worker"></textarea>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Exclude projects</span>
                    <textarea name="exclude_projects" rows="2" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="experimental"></textarea>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Name regex</span>
                    <input name="name_regex" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="^(api|worker)-">
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Tags</span>
                    <input name="tags" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="web, postgres">
                </label>
            </div>
            <label class="block">
                <span class="text-sm font-medium">Metadata match</span>
                <textarea name="metadata_match" rows="3" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm font-mono" placeholder="domain=retail&#10;owner=platform"></textarea>
                <span class="text-xs text-gray-500">One key=value pair per line. Nested keys use dots, e.g. metadata.team.</span>
            </label>
            <div class="grid gap-4 lg:grid-cols-3">
                <label class="block">
                    <span class="text-sm font-medium">Policies JSON</span>
                    <textarea name="policies_json" rows="14" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-xs font-mono" placeholder='{{ policy_example }}'></textarea>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Triggers JSON</span>
                    <textarea name="triggers_json" rows="14" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-xs font-mono" placeholder='{{ trigger_example }}'></textarea>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Pipelines JSON</span>
                    <textarea name="pipelines_json" rows="14" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-xs font-mono" placeholder='{{ pipeline_example }}'></textarea>
                </label>
            </div>
            <button type="submit" class="inline-flex items-center rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">Create rule set</button>
        </form>
    </div>
    {% endif %}
</section>
{% endblock %}

{% extends "base.html.jinja" %}
{% from "components/settings_sidebar.html.jinja" import settings_layout %}

{% block content %}
{% call settings_layout(current_org, "rules") %}
    <div class="flex items-center justify-between mb-8">
        <div>
            <h2 class="text-lg font-bold">Organisation Rules</h2>
            <p class="text-sm text-gray-500 mt-1">
                Apply policies, triggers, and pipelines across matching projects in {{ current_org }}.
            </p>
        </div>
    </div>

    {% if rules | length > 0 %}
    <div class="space-y-4 mb-8">
        {% for rule in rules %}
        <div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
            <div class="px-4 py-3 flex items-start gap-3 flex-wrap border-b border-gray-100">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                    {% if rule.enabled %}
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-green-500 shrink-0" title="Enabled"></span>
                    {% else %}
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-gray-300 shrink-0" title="Disabled"></span>
                    {% endif %}
                    <div class="min-w-0">
                        <h3 class="font-semibold truncate">{{ rule.name }}</h3>
                        <p class="text-xs text-gray-500">
                            {{ rule.policy_count }} policies · {{ rule.trigger_count }} triggers · {{ rule.pipeline_count }} pipelines
                        </p>
                    </div>
                </div>
                {% if is_admin %}
                <form method="POST" action="/orgs/{{ current_org }}/settings/rules/{{ rule.name }}/delete" onsubmit="return confirm('Delete organisation rule set {{ rule.name }}?');">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="text-sm text-red-600 hover:text-red-700">Delete</button>
                </form>
                {% endif %}
            </div>
            <div class="p-4 grid gap-4 lg:grid-cols-2">
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Project selector</h4>
                    <div class="space-y-2 text-sm">
                        {% if rule.name_regex %}<div><span class="text-gray-500">Name regex:</span> <code>{{ rule.name_regex }}</code></div>{% endif %}
                        {% if rule.tags | length > 0 %}
                        <div><span class="text-gray-500">Tags:</span>
                            {% for tag in rule.tags %}<code class="ml-1 px-1 py-0.5 bg-gray-100 rounded">{{ tag }}</code>{% endfor %}
                        </div>
                        {% endif %}
                        {% if rule.include_projects | length > 0 %}
                        <div><span class="text-gray-500">Include:</span> {{ rule.include_projects | join(", ") }}</div>
                        {% endif %}
                        {% if rule.exclude_projects | length > 0 %}
                        <div><span class="text-gray-500">Exclude:</span> {{ rule.exclude_projects | join(", ") }}</div>
                        {% endif %}
                        {% if rule.metadata_match | length > 0 %}
                        <div><span class="text-gray-500">Metadata:</span>
                            {% for pair in rule.metadata_match %}<code class="ml-1 px-1 py-0.5 bg-gray-100 rounded">{{ pair.key }}={{ pair.value }}</code>{% endfor %}
                        </div>
                        {% endif %}
                        {% if not rule.name_regex and rule.tags | length == 0 and rule.include_projects | length == 0 and rule.metadata_match | length == 0 %}
                        <div class="text-gray-500">All projects in this organisation.</div>
                        {% endif %}
                    </div>
                </div>
                <div>
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Matching projects</h4>
                    <div class="rounded-md border border-gray-200 bg-gray-50 p-3 text-sm" data-rule-preview="{{ rule.name }}">
                        Calculating preview…
                    </div>
                </div>
                <details class="text-sm lg:col-span-2">
                    <summary class="cursor-pointer font-medium">Rule payload</summary>
                    <div class="mt-3 grid gap-3">
                        <div>
                            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Policies</div>
                            <pre class="overflow-x-auto rounded bg-gray-950 text-gray-100 p-3 text-xs">{{ rule.policies_json }}</pre>
                        </div>
                        <div>
                            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Triggers</div>
                            <pre class="overflow-x-auto rounded bg-gray-950 text-gray-100 p-3 text-xs">{{ rule.triggers_json }}</pre>
                        </div>
                        <div>
                            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Pipelines</div>
                            <pre class="overflow-x-auto rounded bg-gray-950 text-gray-100 p-3 text-xs">{{ rule.pipelines_json }}</pre>
                        </div>
                    </div>
                </details>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="border border-dashed border-gray-300 rounded-lg p-8 text-center mb-8 bg-white">
        <h3 class="font-semibold mb-1">No organisation rules yet</h3>
        <p class="text-sm text-gray-500">Create a rule set to manage cross-project defaults from one place.</p>
    </div>
    {% endif %}

    {% if is_admin %}
    <div class="border border-gray-200 rounded-lg p-5 bg-white">
        <h3 class="font-semibold mb-1">Create rule set</h3>
        <p class="text-sm text-gray-500 mb-5">Selectors are additive: exact project names, metadata, tags, and a project-name regex all narrow the matching set. Leave selectors empty to target every project.</p>
        <form id="org-rule-form" method="POST" action="/orgs/{{ current_org }}/settings/rules" class="space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                    <span class="text-sm font-medium">Name</span>
                    <input name="name" required class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="default-release-rules">
                </label>
                <label class="flex items-end gap-2 text-sm">
                    <input type="checkbox" name="enabled" checked class="rounded border-gray-300">
                    Enabled
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Include projects</span>
                    <textarea name="include_projects" rows="2" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="api, worker"></textarea>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Exclude projects</span>
                    <textarea name="exclude_projects" rows="2" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="experimental"></textarea>
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Name regex</span>
                    <input name="name_regex" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="^(api|worker)-">
                </label>
                <label class="block">
                    <span class="text-sm font-medium">Tags</span>
                    <input name="tags" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="web, postgres">
                </label>
            </div>
            <label class="block">
                <span class="text-sm font-medium">Metadata match</span>
                <textarea name="metadata_match" rows="3" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm font-mono" placeholder="domain=retail&#10;owner=platform"></textarea>
                <span class="text-xs text-gray-500">One key=value pair per line. Keys match project metadata such as domain, owner, or support_url.</span>
            </label>
            <div>
                <div class="flex items-center justify-between gap-3 mb-2">
                    <span class="text-sm font-medium">Project preview</span>
                    <span class="text-xs text-gray-500">Computed locally from current project metadata.</span>
                </div>
                <div id="new-rule-preview" class="rounded-md border border-gray-200 bg-gray-50 p-3 text-sm">
                    Fill selectors to preview matching projects.
                </div>
            </div>
            <div class="grid gap-4">
                <section class="rounded-lg border border-gray-200 p-4">
                    <h4 class="font-medium mb-3">Policy</h4>
                    <div class="space-y-3">
                        <label class="block">
                            <span class="text-sm font-medium">Policy name</span>
                            <input id="org-policy-name" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="prod-main-only">
                        </label>
                        <label class="block">
                            <span class="text-sm font-medium">Type</span>
                            <select id="org-policy-type" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm bg-white">
                                <option value="branch_restriction">Branch Restriction</option>
                                <option value="soak_time">Soak Time</option>
                                <option value="approval">Approval Required</option>
                            </select>
                        </label>
                        <div id="org-policy-soak-fields" class="hidden space-y-3">
                            <input id="org-policy-source-env" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Source environment, e.g. dev">
                            <input id="org-policy-soak-target-env" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Target environment, e.g. prod">
                            <input id="org-policy-duration" type="number" min="1" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Soak duration seconds, e.g. 1800">
                        </div>
                        <div id="org-policy-branch-fields" class="space-y-3">
                            <input id="org-policy-branch-pattern" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm font-mono" placeholder="Branch pattern, e.g. ^main$">
                            <input id="org-policy-branch-target-env" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Target environment, e.g. prod">
                        </div>
                        <div id="org-policy-approval-fields" class="hidden space-y-3">
                            <input id="org-policy-approval-target-env" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Target environment, e.g. prod">
                            <input id="org-policy-approvals" type="number" min="1" value="1" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Required approvals">
                        </div>
                    </div>
                </section>
                <section class="rounded-lg border border-gray-200 p-4">
                    <h4 class="font-medium mb-3">Trigger</h4>
                    <div class="space-y-3">
                        <input id="org-trigger-name" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm font-mono" placeholder="Trigger name (optional)">
                        <div id="org-trigger-pattern-rows" class="space-y-2"></div>
                        <button type="button" id="org-add-pattern-btn" class="text-sm text-gray-500 hover:text-gray-900">+ Add filter</button>
                        <input id="org-trigger-target-envs" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Target environments, e.g. dev,prod">
                        <input id="org-trigger-target-dests" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="Target destinations, optional">
                        <label class="flex items-center gap-2 text-sm"><input id="org-trigger-force" type="checkbox" class="rounded border-gray-300"> Force release</label>
                        <label class="flex items-center gap-2 text-sm"><input id="org-trigger-pipeline" type="checkbox" class="rounded border-gray-300"> Use release pipeline</label>
                    </div>
                </section>
                <section class="rounded-lg border border-gray-200 p-4">
                    <h4 class="font-medium mb-3">Pipeline</h4>
                    <label class="block mb-3">
                        <span class="text-sm font-medium">Pipeline name</span>
                        <input id="org-pipeline-name" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" placeholder="prod-pipeline">
                    </label>
                    <pipeline-builder data-target="org-pipeline-stages"></pipeline-builder>
                    <textarea id="org-pipeline-stages" hidden></textarea>
                </section>
            </div>
            <details class="rounded-lg border border-gray-200 p-4">
                <summary class="cursor-pointer text-sm font-medium">Advanced JSON payload</summary>
                <p class="text-xs text-gray-500 mt-2 mb-3">The builders above write these arrays on submit. Edit JSON directly when a rule set needs multiple policies, triggers, or pipelines.</p>
                <div class="grid gap-4">
                    <label class="block">
                        <span class="text-sm font-medium">Policies JSON</span>
                        <textarea name="policies_json" rows="10" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-xs font-mono" placeholder='{{ policy_example }}'></textarea>
                    </label>
                    <label class="block">
                        <span class="text-sm font-medium">Triggers JSON</span>
                        <textarea name="triggers_json" rows="10" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-xs font-mono" placeholder='{{ trigger_example }}'></textarea>
                    </label>
                    <label class="block">
                        <span class="text-sm font-medium">Pipelines JSON</span>
                        <textarea name="pipelines_json" rows="10" class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-xs font-mono" placeholder='{{ pipeline_example }}'></textarea>
                    </label>
                </div>
            </details>
            <button type="submit" class="inline-flex items-center rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">Create rule set</button>
        </form>
    </div>
    {% endif %}

    <script id="org-rule-projects-data" type="application/json">{{ projects_json | safe }}</script>
    <script id="org-rule-sets-data" type="application/json">{{ rules_json | safe }}</script>
    <script src="/static/js/pipeline-builder.js"></script>
    <script>
    (function() {
        const projects = JSON.parse(document.getElementById('org-rule-projects-data').textContent || '[]');
        const ruleSets = JSON.parse(document.getElementById('org-rule-sets-data').textContent || '[]');

        function splitCsvLines(value) {
            return (value || '')
                .split(/[,\n\r]/)
                .map(v => v.trim())
                .filter(Boolean);
        }

        function parseMetadataMatch(value) {
            const pairs = {};
            for (const raw of (value || '').split(/\n/)) {
                const line = raw.trim();
                if (!line) continue;
                const idx = line.indexOf('=');
                if (idx === -1) {
                    return { error: 'metadata selector `' + line + '` must use key=value' };
                }
                const key = line.slice(0, idx).trim();
                if (!key) {
                    return { error: 'metadata selector `' + line + '` has an empty key' };
                }
                pairs[key] = line.slice(idx + 1).trim();
            }
            return { pairs };
        }

        function metadataValue(metadata, key) {
            let current = metadata || {};
            for (const part of key.split('.')) {
                if (!part || current == null || typeof current !== 'object' || !(part in current)) return undefined;
                current = current[part];
            }
            return typeof current === 'string' ? current : undefined;
        }

        function matchesSelector(selector) {
            const include = selector.include_projects || [];
            const exclude = selector.exclude_projects || [];
            const tags = selector.tags || [];
            const metadataMatch = selector.metadata_match || {};
            let nameRegex = null;
            if (selector.name_regex) {
                try {
                    nameRegex = new RegExp(selector.name_regex);
                } catch (err) {
                    return { error: 'Invalid name regex: ' + err.message, matches: [] };
                }
            }

            const matches = projects.filter(project => {
                if (include.length > 0 && !include.includes(project.name)) return false;
                if (exclude.includes(project.name)) return false;
                if (nameRegex && !nameRegex.test(project.name)) return false;

                const metadata = project.metadata || {};
                for (const [key, expected] of Object.entries(metadataMatch)) {
                    if (metadataValue(metadata, key) !== expected) return false;
                }

                if (tags.length > 0) {
                    const projectTags = Array.isArray(metadata.tags)
                        ? metadata.tags
                        : String(metadata.tags || '').split(',').map(v => v.trim()).filter(Boolean);
                    if (!tags.every(tag => projectTags.includes(tag))) return false;
                }

                return true;
            });
            return { matches };
        }

        function renderPreview(target, result) {
            target.innerHTML = '';
            if (result.error) {
                const err = document.createElement('p');
                err.className = 'text-sm text-red-600';
                err.textContent = result.error;
                target.appendChild(err);
                return;
            }

            const count = document.createElement('p');
            count.className = 'text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2';
            count.textContent = result.matches.length + ' matching project' + (result.matches.length === 1 ? '' : 's');
            target.appendChild(count);

            if (projects.length === 0) {
                const empty = document.createElement('p');
                empty.className = 'text-gray-500';
                empty.textContent = 'No projects found in this organisation.';
                target.appendChild(empty);
                return;
            }
            if (result.matches.length === 0) {
                const empty = document.createElement('p');
                empty.className = 'text-gray-500';
                empty.textContent = 'No matching projects.';
                target.appendChild(empty);
                return;
            }

            const chips = document.createElement('div');
            chips.className = 'flex flex-wrap gap-1.5';
            for (const project of result.matches.slice(0, 12)) {
                const chip = document.createElement('span');
                chip.className = 'inline-flex rounded bg-white border border-gray-200 px-2 py-0.5 text-xs font-medium text-gray-700';
                chip.textContent = project.name;
                chips.appendChild(chip);
            }
            if (result.matches.length > 12) {
                const more = document.createElement('span');
                more.className = 'inline-flex rounded bg-white border border-gray-200 px-2 py-0.5 text-xs text-gray-500';
                more.textContent = '+' + (result.matches.length - 12) + ' more';
                chips.appendChild(more);
            }
            target.appendChild(chips);
        }

        function setupPolicyBuilder() {
            const type = document.getElementById('org-policy-type');
            if (!type) return;
            const sections = {
                soak_time: document.getElementById('org-policy-soak-fields'),
                branch_restriction: document.getElementById('org-policy-branch-fields'),
                approval: document.getElementById('org-policy-approval-fields'),
            };
            function toggle() {
                for (const [key, el] of Object.entries(sections)) {
                    if (!el) continue;
                    const active = key === type.value;
                    el.classList.toggle('hidden', !active);
                    el.querySelectorAll('input').forEach(input => input.disabled = !active);
                }
            }
            type.addEventListener('change', toggle);
            toggle();
        }

        function setupTriggerBuilder() {
            const rows = document.getElementById('org-trigger-pattern-rows');
            const addBtn = document.getElementById('org-add-pattern-btn');
            if (!rows || !addBtn) return;
            const patternTypes = [
                { value: 'branch_pattern', label: 'Branch', placeholder: 'e.g. ^main$' },
                { value: 'title_pattern', label: 'Title', placeholder: 'e.g. ^Release.*' },
                { value: 'author_pattern', label: 'Author', placeholder: 'e.g. ci-bot' },
                { value: 'commit_message_pattern', label: 'Commit message', placeholder: 'e.g. ^Merge pull request.*' },
                { value: 'source_type_pattern', label: 'Source type', placeholder: 'e.g. woodpecker' },
            ];
            function usedTypes() {
                return new Set(Array.from(rows.querySelectorAll('select')).map(sel => sel.value));
            }
            function refreshOptions() {
                const used = usedTypes();
                rows.querySelectorAll('select').forEach(sel => {
                    const current = sel.value;
                    sel.querySelectorAll('option').forEach(opt => {
                        opt.disabled = used.has(opt.value) && opt.value !== current;
                    });
                });
                addBtn.classList.toggle('hidden', used.size >= patternTypes.length);
            }
            function addPatternRow() {
                const used = usedTypes();
                const type = patternTypes.find(item => !used.has(item.value));
                if (!type) return;
                const row = document.createElement('div');
                row.className = 'flex items-center gap-2';
                row.innerHTML = `
                    <select class="w-40 rounded-md border border-gray-300 px-2 py-1.5 text-sm bg-white">
                        ${patternTypes.map(item => `<option value="${item.value}" ${item.value === type.value ? 'selected' : ''}>${item.label}</option>`).join('')}
                    </select>
                    <input class="flex-1 rounded-md border border-gray-300 px-3 py-1.5 text-sm font-mono" placeholder="${type.placeholder}">
                    <button type="button" class="text-gray-400 hover:text-red-500" title="Remove">×</button>
                `;
                const select = row.querySelector('select');
                const input = row.querySelector('input');
                select.addEventListener('change', () => {
                    const selected = patternTypes.find(item => item.value === select.value);
                    input.placeholder = selected ? selected.placeholder : '';
                    refreshOptions();
                });
                row.querySelector('button').addEventListener('click', () => {
                    row.remove();
                    refreshOptions();
                });
                rows.appendChild(row);
                refreshOptions();
            }
            addBtn.addEventListener('click', addPatternRow);
            addPatternRow();
        }

        function slugify(value, fallback) {
            const slug = (value || '')
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');
            return slug || fallback;
        }

        function buildPolicyFromForm() {
            const name = document.getElementById('org-policy-name')?.value.trim();
            if (!name) return null;
            const type = document.getElementById('org-policy-type').value;
            if (type === 'soak_time') {
                const source = document.getElementById('org-policy-source-env').value.trim();
                const target = document.getElementById('org-policy-soak-target-env').value.trim();
                const duration = Number(document.getElementById('org-policy-duration').value);
                if (!source || !target || !Number.isFinite(duration) || duration < 1) {
                    throw new Error('Soak policies require source environment, target environment, and a positive duration.');
                }
                return { name, enabled: true, config: { SoakTime: { source_environment: source, target_environment: target, duration_seconds: duration } } };
            }
            if (type === 'approval') {
                const target = document.getElementById('org-policy-approval-target-env').value.trim();
                const approvals = Number(document.getElementById('org-policy-approvals').value || '1');
                if (!target || !Number.isFinite(approvals) || approvals < 1) {
                    throw new Error('Approval policies require a target environment and at least one approval.');
                }
                return { name, enabled: true, config: { Approval: { target_environment: target, required_approvals: approvals } } };
            }
            const target = document.getElementById('org-policy-branch-target-env').value.trim();
            const branch = document.getElementById('org-policy-branch-pattern').value.trim();
            if (!target || !branch) {
                throw new Error('Branch policies require a target environment and branch pattern.');
            }
            return { name, enabled: true, config: { BranchRestriction: { target_environment: target, branch_pattern: branch } } };
        }

        function buildTriggerFromForm() {
            const patterns = {};
            document.querySelectorAll('#org-trigger-pattern-rows > div').forEach(row => {
                const key = row.querySelector('select').value;
                const value = row.querySelector('input').value.trim();
                if (value) patterns[key] = value;
            });
            const targetEnvironments = splitCsvLines(document.getElementById('org-trigger-target-envs')?.value || '');
            const targetDestinations = splitCsvLines(document.getElementById('org-trigger-target-dests')?.value || '');
            const forceRelease = document.getElementById('org-trigger-force')?.checked || false;
            const usePipeline = document.getElementById('org-trigger-pipeline')?.checked || false;
            const explicitName = document.getElementById('org-trigger-name')?.value.trim();
            const hasTrigger = explicitName || Object.keys(patterns).length > 0 || targetEnvironments.length > 0 || targetDestinations.length > 0 || forceRelease || usePipeline;
            if (!hasTrigger) return null;
            if (!usePipeline && targetEnvironments.length === 0 && targetDestinations.length === 0) {
                throw new Error('Triggers must target at least one environment or destination unless they use a release pipeline.');
            }
            const firstPattern = Object.values(patterns)[0] || 'release';
            const targetPart = targetEnvironments[0] || targetDestinations[0] || 'pipeline';
            return {
                name: explicitName || slugify(firstPattern + '-to-' + targetPart, 'org-trigger'),
                enabled: true,
                branch_pattern: patterns.branch_pattern || null,
                title_pattern: patterns.title_pattern || null,
                author_pattern: patterns.author_pattern || null,
                commit_message_pattern: patterns.commit_message_pattern || null,
                source_type_pattern: patterns.source_type_pattern || null,
                target_environments: targetEnvironments,
                target_destinations: targetDestinations,
                force_release: forceRelease,
                use_pipeline: usePipeline,
            };
        }

        function buildPipelineFromForm() {
            const name = document.getElementById('org-pipeline-name')?.value.trim();
            const rawStages = document.getElementById('org-pipeline-stages')?.value.trim();
            if (!name && !rawStages) return null;
            if (!name) throw new Error('Pipelines require a name.');
            const stages = rawStages ? JSON.parse(rawStages) : [];
            if (!Array.isArray(stages) || stages.length === 0) {
                throw new Error('Pipelines require at least one stage.');
            }
            return { name, enabled: true, stages };
        }

        function wireRuleBuilders(form) {
            setupPolicyBuilder();
            setupTriggerBuilder();
            form.addEventListener('submit', event => {
                try {
                    const policy = buildPolicyFromForm();
                    if (policy) form.elements.policies_json.value = JSON.stringify([policy], null, 2);
                    const trigger = buildTriggerFromForm();
                    if (trigger) form.elements.triggers_json.value = JSON.stringify([trigger], null, 2);
                    const pipeline = buildPipelineFromForm();
                    if (pipeline) form.elements.pipelines_json.value = JSON.stringify([pipeline], null, 2);
                } catch (err) {
                    event.preventDefault();
                    alert(err.message);
                }
            });
        }

        document.querySelectorAll('[data-rule-preview]').forEach(target => {
            const name = target.getAttribute('data-rule-preview');
            const rule = ruleSets.find(item => item.name === name);
            renderPreview(target, matchesSelector((rule && rule.selector) || {}));
        });

        const form = document.getElementById('org-rule-form');
        const livePreview = document.getElementById('new-rule-preview');
        if (form && livePreview) {
            function updateLivePreview() {
                const metadata = parseMetadataMatch(form.elements.metadata_match.value);
                if (metadata.error) {
                    renderPreview(livePreview, { error: metadata.error, matches: [] });
                    return;
                }
                renderPreview(livePreview, matchesSelector({
                    include_projects: splitCsvLines(form.elements.include_projects.value),
                    exclude_projects: splitCsvLines(form.elements.exclude_projects.value),
                    name_regex: form.elements.name_regex.value.trim() || null,
                    metadata_match: metadata.pairs,
                    tags: splitCsvLines(form.elements.tags.value),
                }));
            }
            ['include_projects', 'exclude_projects', 'name_regex', 'metadata_match', 'tags'].forEach(name => {
                form.elements[name].addEventListener('input', updateLivePreview);
            });
            wireRuleBuilders(form);
            updateLivePreview();
        }
    })();
    </script>
{% endcall %}
{% endblock %}

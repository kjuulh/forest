{% extends "base.html.jinja" %}

{% block content %}
<section class="max-w-4xl mx-auto px-4 pt-24 pb-12 text-center">
    <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Release platform + component exchange</p>
    <h1 class="mt-3 text-5xl font-bold tracking-tight leading-tight">
        From code to a running app.<br>Your runtime or ours.
    </h1>
    <p class="mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
        Forest gives application teams one fast release path. Run on Forest Runtime,
        or deploy to your own infrastructure through a versioned provider—using the same
        components, policy, pipeline, and release history.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="mailto:contact@kjuulh.io?subject=Forest%20private%20preview" class="px-5 py-2.5 bg-gray-900 text-white rounded-md text-sm font-medium hover:bg-gray-800">Join the waitlist</a>
        <a href="/pricing" class="px-5 py-2.5 border border-gray-300 rounded-md text-sm font-medium hover:border-gray-400">See pricing strategy</a>
    </div>
</section>

<section class="max-w-4xl mx-auto px-4 py-12">
    {# `code-surface` keeps this block dark in both light and dark mode. #}
    <div class="code-surface rounded-lg p-6 text-sm font-mono overflow-x-auto">
        <pre><span class="text-gray-500"># Adopt the platform team's versioned delivery contract</span>
<span class="text-green-400">$</span> forest add acme/service-standard@1.4.0
<span class="text-green-400">$</span> forest validate

<span class="text-gray-500"># Managed Forest Runtime in dev</span>
<span class="text-green-400">$</span> forest release create --environment dev

<span class="text-gray-500"># Customer-owned infrastructure behind the production provider</span>
<span class="text-green-400">$</span> forest release create --environment prod --pipeline</pre>
    </div>
    <p class="mt-4 text-center text-sm text-gray-500">
        The destination changes. The application release workflow does not.
    </p>
</section>

<section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-center mb-12">One delivery contract, two ways to run</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 border border-gray-200 rounded-lg">
            <h3 class="font-bold text-lg mb-2">Versioned release capabilities</h3>
            <p class="text-gray-600 text-sm">
                Package build, deployment, policy, and developer tooling as typed components. Lock exact versions in each application.
            </p>
        </div>
        <div class="p-6 border border-gray-200 rounded-lg">
            <h3 class="font-bold text-lg mb-2">Forest Runtime</h3>
            <p class="text-gray-600 text-sm">
                Take the managed path from a release declaration to a running container service without operating the destination yourself.
            </p>
        </div>
        <div class="p-6 border border-gray-200 rounded-lg">
            <h3 class="font-bold text-lg mb-2">Your infrastructure</h3>
            <p class="text-gray-600 text-sm">
                Keep your clusters, cloud accounts, and spend. Forest providers translate the same release into your target platform.
            </p>
        </div>
    </div>
</section>

<section class="max-w-4xl mx-auto px-4 py-12">
    <div class="p-6 border border-amber-200 bg-amber-50 rounded-lg">
        <h2 class="font-bold text-lg">Private development preview</h2>
        <p class="mt-2 text-sm text-gray-700">
            Forest Runtime and provider-backed releases exist, but neither carries a production hosting guarantee yet. Forest is currently suitable only for trusted internal evaluation on a private network. Native components run with the invoking user's privileges, and runner, provider, artifact, and tenant isolation require further hardening before external use.
        </p>
    </div>
</section>
{% endblock %}

{% extends "base.html.jinja" %}

{% block content %}
<section class="max-w-md mx-auto pt-16 px-4">
    <div class="border border-gray-200 rounded-xl p-8 shadow-sm">
        <h1 class="text-xl font-bold text-center">Authorize {{ app_name }}</h1>
        <p class="text-sm text-gray-500 text-center mt-2">
            <span class="font-medium">{{ app_name }}</span> wants to access your Forest account
            {% if user %}(<span class="font-mono">{{ user.username }}</span>){% endif %}.
        </p>

        <div class="mt-6 border border-gray-100 rounded-lg divide-y divide-gray-100">
            {% for scope in scopes %}
            <div class="flex items-start gap-3 px-4 py-3">
                <svg class="w-5 h-5 text-green-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <div>
                    <div class="text-sm font-medium text-gray-900 font-mono">{{ scope.name }}</div>
                    <div class="text-xs text-gray-500">{{ scope.description }}</div>
                </div>
            </div>
            {% endfor %}
        </div>

        {% if app_homepage %}
        <p class="text-xs text-gray-400 text-center mt-4">
            {{ app_name }} &middot; <a href="{{ app_homepage }}" class="underline" rel="noopener noreferrer nofollow">{{ app_homepage }}</a>
        </p>
        {% endif %}

        <form method="POST" action="/oauth/authorize" class="mt-6 space-y-3">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="hidden" name="client_id" value="{{ client_id }}">
            <input type="hidden" name="redirect_uri" value="{{ redirect_uri }}">
            <input type="hidden" name="scope" value="{{ scope }}">
            <input type="hidden" name="consent_binding" value="{{ consent_binding }}">
            <input type="hidden" name="state" value="{{ state }}">
            <input type="hidden" name="code_challenge" value="{{ code_challenge }}">
            <input type="hidden" name="code_challenge_method" value="{{ code_challenge_method }}">
            <input type="hidden" name="nonce" value="{{ nonce }}">

            <button type="submit" name="action" value="approve"
                    class="w-full px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800">
                Authorize {{ app_name }}
            </button>
            <button type="submit" name="action" value="deny"
                    class="w-full px-4 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50">
                Cancel
            </button>
        </form>

        <p class="text-xs text-gray-400 text-center mt-4">
            You'll be redirected to <span class="font-mono break-all">{{ redirect_uri }}</span>.
        </p>
    </div>
</section>
{% endblock %}

{% extends "base.html.jinja" %}
{% from "components/project_settings.html.jinja" import project_settings_layout %}
{% from "components/visibility.html.jinja" import visibility_state, read_only_note, visibility_form, admin_only_note %}

{% block content %}
{% call project_settings_layout(current_org, current_project, "visibility", "Visibility",
                                "Who outside " ~ current_org ~ " can read this component") %}
    <div class="space-y-6 max-w-2xl">
        {% if flash_error %}
        <div role="alert" class="p-3 rounded-md bg-red-50 border border-red-200 text-sm text-red-800">{{ flash_error }}</div>
        {% endif %}

        <div class="p-4 border border-gray-200 rounded-lg">
            <dl class="text-sm space-y-3">
                <div class="flex items-center justify-between">
                    <dt class="text-gray-500">Visible outside the organisation</dt>
                    <dd>{{ visibility_state(component_public) }}</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-gray-500">This component's own setting</dt>
                    <dd>{{ visibility_state(project_public) }}</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-gray-500">Organisation <a href="/orgs/{{ current_org }}/settings/visibility" class="underline hover:text-gray-900">{{ current_org }}</a></dt>
                    <dd>{{ visibility_state(org_public) }}</dd>
                </div>
            </dl>
        </div>

        {% if org_public %}
        <div class="p-3 rounded-md bg-amber-50 border border-amber-200 text-sm text-amber-900">
            This component is public through the organisation: {{ current_org }} is public, so every
            component it publishes is visible to anyone, even without signing in. Setting this component to private
            does not make it private while the organisation is public. Change that in the
            <a href="/orgs/{{ current_org }}/settings/visibility" class="underline font-medium">organisation's visibility settings</a>.
        </div>
        {% endif %}

        {{ read_only_note() }}

        {% if can_change %}
        {{ visibility_form(current_org, current_project, csrf_token, project_public) }}
        {% else %}
        {{ admin_only_note() }}
        {% endif %}
    </div>
{% endcall %}
{% endblock %}

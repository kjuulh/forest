{% extends "base.html.jinja" %}

{% block content %}
<section class="app-container py-12">
    <div class="mb-8">
        <a href="/orgs/{{ current_org }}/settings/integrations" class="text-sm text-gray-500 hover:text-gray-700">&larr; All integrations</a>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-lg border border-gray-200 flex items-center justify-center bg-white shrink-0"><svg class="w-6 h-6 text-gray-600" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg></div>
            <div>
                <h1 class="text-2xl font-bold">{{ integration.name }}</h1>
                <div class="flex flex-wrap items-center gap-2 mt-1">
                    <span class="text-sm text-gray-500">GitHub organisation {{ account_login }} &middot; connected by {{ installed_by_login }}</span>
                    {% if health == "healthy" %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700">Healthy</span>
                    {% elif health == "uninstalled" %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-50 text-red-700">Uninstalled on GitHub</span>
                    {% elif health == "suspended" %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-50 text-yellow-800">Suspended on GitHub</span>
                    {% else %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">Could not reach GitHub</span>
                    {% endif %}
                </div>
            </div>
        </div>
        <form method="POST" action="/orgs/{{ current_org }}/settings/integrations/{{ integration.id }}/delete" onsubmit="return confirm('Disconnect this GitHub organisation from Forest? Uninstall the app on GitHub too to revoke its access.')">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <button type="submit" class="px-3 py-1.5 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50 transition-colors">Disconnect</button>
        </form>
    </div>

    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Attribution coverage</h2>
    <p class="text-sm text-gray-500 mb-3">A release authored on GitHub reaches its author individually only when they linked that GitHub account to their Forest account (signing in with GitHub does this). GitHub membership is shown for context and never grants access to Forest.</p>
    {% if truncated %}<p class="text-sm text-gray-500 mb-3">The GitHub organisation is large; only its first 2000 members were checked.</p>{% endif %}
    <div class="border border-gray-200 rounded-lg divide-y divide-gray-100">
        {% for r in rows %}
        <div class="px-4 py-3 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
            <div class="sm:w-48 shrink-0">
                <span class="text-sm font-medium text-gray-900">{{ r.username }}</span>
                <span class="text-xs text-gray-400 ml-1">{{ r.role }}</span>
            </div>
            <div class="flex items-start gap-2 min-w-0">
                {% if r.state == "reachable" %}
                <span class="inline-flex shrink-0 items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700">Attributable</span>
                {% elif r.state == "gap" %}
                <span class="inline-flex shrink-0 items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-50 text-yellow-800">Setup gap</span>
                {% else %}
                <span class="inline-flex shrink-0 items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">Unknown</span>
                {% endif %}
                <span class="text-sm text-gray-600 break-words">{{ r.detail }}</span>
            </div>
        </div>
        {% endfor %}
    </div>
</section>
{% endblock %}

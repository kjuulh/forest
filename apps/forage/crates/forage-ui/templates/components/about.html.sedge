use crate::about::About;
use crate::components::Icon;
component AboutBlock(about: &About) {
{if !about.is_empty() {
  <div>
    <h3 class="text-sm font-bold mb-2 flex items-center gap-2">
      <Icon name="info" class="w-4 h-4 text-gray-400" />
      About
    </h3>
    {if !about.links.is_empty() {
      <ul class="space-y-1.5 text-sm">
        {for link in about.links.iter() {
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" title={link.href} class="group flex items-center gap-2 text-gray-700 hover:text-gray-900 transition-colors">
              <Icon name={link.kind.icon()} class="w-4 h-4 text-gray-400 group-hover:text-gray-700 shrink-0 transition-colors" />
              <span class="font-medium truncate group-hover:underline">{link.label}</span>
            </a>
          </li>
        }}
      </ul>
    }}
    {if about.has_facts() {
      {if !about.links.is_empty() { <div class="border-t border-gray-100 my-3"></div> }}
      <dl class="text-sm space-y-2">
        {if !about.domain.is_empty() {
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Domain</dt>
            <dd class="text-gray-700">{about.domain}</dd>
          </div>
        }}
        {if !about.owner.is_empty() {
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-500">Owner</dt>
            <dd class="text-gray-700">{about.owner}</dd>
          </div>
        }}
      </dl>
    }}
  </div>
}}
}

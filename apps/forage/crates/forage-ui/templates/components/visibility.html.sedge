use crate::components::CsrfField;
use crate::format::urlencode;
component VisibilityState(public: bool) {
{if *public {
  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Public</span>
} else {
  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">Private</span>
}}
}
component VisibilityReadOnlyNote() {
<p class="text-sm text-gray-600">
  <strong>Public is read-only.</strong> A public component is listed on the public registry
  pages, with its readme, versions and manifest, for anyone to see, <em>including people who are
  not signed in</em>. Anyone signed in to Forest can also resolve and download it. Publishing,
  unpublishing and every other change still need membership of the organisation. The
  organisation's releases, destinations, members and settings are not shared.
</p>
}
component VisibilityForm(org: &str, project: Option<&str>, csrf_token: &str, public: bool) {
{let action = match project {
  Some(project) => format!("/orgs/{}/projects/{}/settings/visibility", urlencode(org), urlencode(project)),
  None => format!("/orgs/{}/settings/visibility", urlencode(org)),
};}
{let subject = match project {
  Some(project) => format!("{org}/{project}"),
  None => org.to_string(),
};}
<form method="POST" action={action} class="space-y-3">
  <CsrfField token={csrf_token} name="_csrf" />
  <fieldset class="space-y-2">
    <legend class="sr-only">Visibility of {subject}</legend>
    <label class="flex items-start gap-2 text-sm">
      <input type="radio" name="visibility" value="private" checked={!*public} class="mt-0.5">
      <span><span class="font-medium">Private</span> — only members of the organisation can read it.</span>
    </label>
    <label class="flex items-start gap-2 text-sm">
      <input type="radio" name="visibility" value="public" checked={*public} class="mt-0.5">
      <span><span class="font-medium">Public</span> — anyone can see it, even without signing in, and anyone signed in can use it. Read-only.</span>
    </label>
  </fieldset>
  <button type="submit" class="px-4 py-2 text-sm font-medium bg-gray-900 text-white rounded-md hover:bg-gray-800">Save visibility</button>
</form>
}
component VisibilityAdminOnlyNote() {
<p class="text-sm text-gray-500">Only an organisation admin can change this.</p>
}

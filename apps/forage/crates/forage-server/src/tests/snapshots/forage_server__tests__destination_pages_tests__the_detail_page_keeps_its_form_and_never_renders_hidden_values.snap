---
source: crates/forage-server/src/tests/destination_pages_tests.rs
expression: main_element(&html)
---
<main class="flex-1 pb-16">
<section class="app-container py-12">
<nav class="flex items-center gap-1.5 text-sm text-gray-500 mb-6">
<a href="/orgs/testorg/destinations" class="hover:text-gray-900 transition-colors">Destinations</a>
<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
<span class="text-gray-900 font-medium">app prod&amp;eu</span>
</nav>
<div class="flex items-start justify-between mb-8">
<div>
<h1 class="text-2xl font-bold text-gray-900">app prod&amp;eu</h1>
<p class="text-sm text-gray-500 mt-1">
          Environment:
          <span class="inline-flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full shrink-0 bg-pink-500"></span>
<span class="font-medium text-gray-700">prod</span>
</span>
</p>
</div>
</div>
<div class="border border-gray-200 rounded-lg overflow-hidden mb-6">
<div class="px-5 py-3 bg-gray-50">
<span class="text-sm font-medium text-gray-900">Type</span>
</div>
<div class="px-5 py-4">
<div class="flex items-center gap-4">
<div>
<span class="text-xs text-gray-500">Name</span>
<p class="text-sm font-medium text-gray-900">terraform</p>
</div>
<div>
<span class="text-xs text-gray-500">Organisation</span>
<p class="text-sm font-medium text-gray-900">forest</p>
</div>
<div>
<span class="text-xs text-gray-500">Version</span>
<p class="text-sm font-medium text-gray-900">v2</p>
</div>
</div>
</div>
</div>
<div class="border border-gray-200 rounded-lg overflow-hidden">
<div class="px-5 py-3 bg-gray-50 flex items-center justify-between">
<span class="text-sm font-medium text-gray-900">Metadata</span>
<span class="flex items-center gap-3">
<span class="text-xs text-gray-400">1 hidden</span>
<span class="text-xs text-gray-400">3 keys</span>
</span>
</div>
<form method="post" action="/orgs/testorg/destinations/detail/update?name=app%20prod%26eu" id="metadata-form" data-declared-sensitive="[&quot;api_token&quot;]" data-reveal-url="/orgs/testorg/destinations/detail/reveal?name=app%20prod%26eu">
<input type="hidden" name="_csrf" value="test-csrf">
<div class="divide-y divide-gray-100" id="metadata-rows">
<div class="px-5 py-3 flex items-center gap-3 metadata-row">
<input type="text" name="metadata_keys" value="account" placeholder="key" class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono">
<input type="text" name="metadata_values" value="1234" placeholder="value" class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono">
<label class="shrink-0 flex items-center gap-1 text-xs text-gray-400 hover:text-gray-600 cursor-pointer" title="Mark as a credential: the value is hidden after saving. This cannot be undone from the UI.">
<input type="checkbox" class="meta-sensitive accent-green-600">secret
</label>
<button type="button" class="remove-meta-row text-gray-300 hover:text-red-500 transition-colors p-1" title="Remove row"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
</div><div class="px-5 py-3 flex items-center gap-3 metadata-row">
<input type="text" name="metadata_keys" value="api_token" placeholder="key" readonly class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono bg-gray-50 text-gray-500">
<input type="hidden" name="preserve_sensitive_keys" value="api_token">
<div class="flex-1 flex items-center gap-2">
<input type="text" name="metadata_values" value="" autocomplete="off" data-sensitive-key="api_token" placeholder="hidden — leave blank to keep, or type to replace" class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono">
<button type="button" class="reveal-btn shrink-0 text-xs px-2 py-1 border border-gray-200 rounded-md text-gray-500 hover:text-gray-900 hover:border-gray-300 transition-colors" data-key="api_token" title="Fetch and show this value">Reveal</button>
</div>
<span class="shrink-0 text-xs text-gray-400" title="Marked a credential on this destination. Un-hiding it is deliberate: use `forest destination update --clear-sensitive`.">secret</span>
<button type="button" class="remove-meta-row text-gray-300 hover:text-red-500 transition-colors p-1" title="Remove row"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
</div><div class="px-5 py-3 flex items-center gap-3 metadata-row">
<input type="text" name="metadata_keys" value="region" placeholder="key" class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono">
<input type="text" name="metadata_values" value="eu-west-1" placeholder="value" class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono">
<label class="shrink-0 flex items-center gap-1 text-xs text-gray-400 hover:text-gray-600 cursor-pointer" title="Mark as a credential: the value is hidden after saving. This cannot be undone from the UI.">
<input type="checkbox" class="meta-sensitive accent-green-600">secret
</label>
<button type="button" class="remove-meta-row text-gray-300 hover:text-red-500 transition-colors p-1" title="Remove row"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
</div>
<div class="px-5 py-3 flex items-center gap-3 metadata-row">
<input type="text" name="metadata_keys" placeholder="key" class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono">
<input type="text" name="metadata_values" placeholder="value" class="flex-1 text-sm px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono">
<label class="shrink-0 flex items-center gap-1 text-xs text-gray-400 hover:text-gray-600 cursor-pointer" title="Mark as a credential: the value is hidden after saving. This cannot be undone from the UI.">
<input type="checkbox" class="meta-sensitive accent-green-600">secret
</label>
<button type="button" class="remove-meta-row text-gray-300 hover:text-red-500 transition-colors p-1" title="Remove row"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
</div>
</div>
<div class="px-5 py-3 border-t border-gray-100 flex items-center justify-between">
<button type="button" id="add-row-btn" class="text-sm text-green-600 hover:text-green-700 font-medium transition-colors flex items-center gap-1">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Add row
            </button>
<button type="submit" class="px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 transition-colors">
              Save metadata
            </button>
</div>
</form>
</div>
</section>
</main>

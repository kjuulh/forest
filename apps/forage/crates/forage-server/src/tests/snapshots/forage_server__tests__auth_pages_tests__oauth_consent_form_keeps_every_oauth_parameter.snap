---
source: crates/forage-server/src/tests/auth_pages_tests.rs
expression: masked_main(&page.html)
---
<main class="flex-1 pb-16">
<section class="max-w-md mx-auto pt-16 px-4">
<div class="border border-gray-200 rounded-xl p-8 shadow-sm">
<h1 class="text-xl font-bold text-center">Authorize Seeded App</h1>
<p class="text-sm text-gray-500 text-center mt-2">
<span class="font-medium">Seeded App</span> wants to access your Forest account
        (<span class="font-mono">testuser</span>).
      </p>
<div class="mt-6 border border-gray-100 rounded-lg divide-y divide-gray-100">
<div class="flex items-start gap-3 px-4 py-3">
<svg class="w-5 h-5 text-green-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
<div>
<div class="text-sm font-medium text-gray-900 font-mono">openid</div>
<div class="text-xs text-gray-500">Confirm your identity</div>
</div>
</div><div class="flex items-start gap-3 px-4 py-3">
<svg class="w-5 h-5 text-green-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
<div>
<div class="text-sm font-medium text-gray-900 font-mono">profile</div>
<div class="text-xs text-gray-500">Your username, account ID and avatar</div>
</div>
</div>
</div>

<form method="POST" action="/oauth/authorize" class="mt-6 space-y-3">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="client_id" value="forest_oa_testclient">
<input type="hidden" name="redirect_uri" value="https://app.example/cb">
<input type="hidden" name="scope" value="openid profile">
<input type="hidden" name="consent_binding" value="BINDING">
<input type="hidden" name="state" value="st&quot;&gt;&lt;x">
<input type="hidden" name="code_challenge" value="chal">
<input type="hidden" name="code_challenge_method" value="S256">
<input type="hidden" name="nonce" value="n-1">
<button type="submit" name="action" value="approve" class="w-full px-4 py-2.5 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800">
          Authorize Seeded App
</button>
<button type="submit" name="action" value="deny" class="w-full px-4 py-2.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50">
          Cancel
        </button>
</form>
<p class="text-xs text-gray-400 text-center mt-4">
        You'll be redirected to <span class="font-mono break-all">https://app.example/cb</span>.
      </p>
</div>
</section>
</main>

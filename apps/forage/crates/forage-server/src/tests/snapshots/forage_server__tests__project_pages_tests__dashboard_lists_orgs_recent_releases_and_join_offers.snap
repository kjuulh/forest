<form method="POST" action="/orgs" class="flex gap-2 mt-3">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="text" name="name" placeholder="new-org-name" pattern="[a-z0-9][a-z0-9-]*" class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
<button type="submit" class="px-4 py-2 text-sm bg-gray-900 text-white rounded-md hover:bg-gray-800 whitespace-nowrap">
            Create

<div class="flex-1 min-w-0">
<div class="mb-6">
<h2 class="text-lg font-bold">staging-soak-30m</h2>
<p class="text-sm text-gray-500 mt-1">Update the conditions this policy gates on.</p>
</div>
<div class="border border-gray-200 rounded-lg p-6"><form method="post" action="/orgs/testorg/projects/my-api/settings/policies/aaaaaaaa-0000-0000-0000-000000000001" class="space-y-4">
<input type="hidden" name="csrf_token" value="test-csrf">
<input type="hidden" name="policy_type" value="soak_time">
<div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
<span>Type:</span>
<span class="bg-indigo-100 text-indigo-700 px-1.5 py-0.5 rounded text-xs font-medium">Soak Time</span>
</div>
<div class="grid grid-cols-2 gap-4">
<div>
<label class="block text-sm font-medium text-gray-700 mb-1">Source environment</label>
<select name="source_environment" class="w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white">

<option value="dev">dev</option><option value="staging" selected>staging</option><option value="prod">prod</option>
</select>
</div>
<div>
<label class="block text-sm font-medium text-gray-700 mb-1">Target environment</label>
<select name="target_environment" class="w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm bg-white">

<option value="dev">dev</option><option value="staging">staging</option><option value="prod" selected>prod</option>
</select>
</div>
</div>
<div>
<label class="block text-sm font-medium text-gray-700 mb-1">Soak duration (seconds)</label>
<input type="number" name="duration_seconds" min="1" value="5400" class="w-48 border border-gray-300 rounded-md px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900">
<p class="text-xs text-gray-500 mt-1">e.g. 1800 = 30 minutes, 3600 = 1 hour</p>
</div>
<div class="flex items-center gap-3 pt-2">
<button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm hover:bg-gray-800 transition-colors">Save Changes</button>
<a href="/orgs/testorg/projects/my-api/settings/policies" class="text-sm text-gray-500 hover:text-gray-900">Cancel</a>
</div>
</form></div>
</div>
</div>
</section>

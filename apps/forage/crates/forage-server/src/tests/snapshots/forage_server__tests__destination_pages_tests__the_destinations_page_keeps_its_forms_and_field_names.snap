<button type="button" class="export-dest text-gray-300 hover:text-gray-600 transition-colors p-1 shrink-0" title="Copy JSON to clipboard" data-name="app prod&amp;eu" data-env="prod" data-type-org="forest" data-type-name="terraform" data-type-version="2" data-metadata="{&quot;account&quot;:&quot;1234&quot;,&quot;region&quot;:&quot;eu-west-1&quot;}" data-sensitive-keys="[&quot;api_token&quot;]">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
</button>
</div>
</div>

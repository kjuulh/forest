</div>
<div class="flex items-center gap-2 shrink-0">
<form method="post" action="/orgs/testorg/projects/my-api/settings/pipelines/p1/toggle">
<input type="hidden" name="_csrf" value="test-csrf">
<button type="submit" class="text-xs px-2.5 py-1 rounded border border-gray-300 text-gray-600 hover:bg-gray-50">Disable</button>
</form>
<form method="post" action="/orgs/testorg/projects/my-api/settings/pipelines/p1/delete" data-confirm="Delete pipeline &quot;standard&quot;?">
<input type="hidden" name="_csrf" value="test-csrf">
<button type="submit" class="text-xs px-2.5 py-1 rounded border border-red-300 text-red-600 hover:bg-red-50">Delete</button>
</form>
</div>
<svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
</summary>
<div class="border-t border-gray-100 px-4 py-3">
<form method="post" action="/orgs/testorg/projects/my-api/settings/pipelines/p1/update" class="space-y-3">
<input type="hidden" name="_csrf" value="test-csrf">
<pipeline-builder data-target="edit-standard"></pipeline-builder>
<textarea id="edit-standard" name="stages_json" hidden>[{&quot;id&quot;:&quot;dev&quot;,&quot;depends_on&quot;:[],&quot;config&quot;:{&quot;Deploy&quot;:{&quot;environment&quot;:&quot;dev&lt;/textarea&gt;&lt;b&gt;&quot;}}},{&quot;id&quot;:&quot;soak&quot;,&quot;depends_on&quot;:[&quot;dev&quot;],&quot;config&quot;:{&quot;Wait&quot;:{&quot;duration_seconds&quot;:60}}}]</textarea>
<button type="submit" class="text-xs px-3 py-1.5 rounded bg-gray-900 text-white hover:bg-gray-800">Save Changes</button>
</form>
</div>

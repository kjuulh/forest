<main class="flex-1 pb-16">
<section class="app-container pt-12">
<div class="flex items-center justify-between mb-8 gap-4">
<h1 class="text-2xl font-bold">Components</h1>
<details class="relative shrink-0 group">
<summary class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 cursor-pointer list-none select-none">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            Install
            <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
</summary>
<div class="absolute right-0 mt-2 w-96 max-w-[calc(100vw-2rem)] bg-white border border-gray-200 rounded-md shadow-lg z-10 p-4 space-y-3">
<div>
<p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1.5">Subscribe to every tool in testorg</p>
<div class="relative group bg-[#0a0a0a] rounded-md text-sm font-mono text-[#d1d5db] ">
<div class="overflow-x-auto p-3 pr-12">
<pre id="org-install-cmd" class="whitespace-pre">forest global add testorg</pre>
</div>
<button type="button" data-copy="org-install-cmd" class="absolute top-2 right-2 px-2 py-0.5 text-xs bg-[#1f2937] text-[#9ca3af] rounded hover:text-white opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity">Copy</button>
</div>
</div>
<p class="text-xs text-gray-500">Subscribes your workstation to <span class="font-mono">testorg</span>'s catalogue. Forest installs shims for every tool the org publishes and keeps them in sync.</p>
</div>
</details>
</div>
<form method="GET" action="/orgs/testorg/components" class="flex gap-3 mb-8">
<input type="text" name="q" value="dep" placeholder="Search components..." class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-gray-900 focus:border-gray-900 outline-none">

---
source: crates/forage-server/src/tests/auth_pages_tests.rs
expression: masked_main(&page.html)
---
<main class="flex-1 pb-16">
<section class="max-w-md mx-auto px-4 pt-24">
<h1 class="text-2xl font-bold text-center mb-2">Two-factor authentication</h1>
<p class="text-center text-sm text-gray-500 mb-8">Open your authenticator app and enter the 6-digit code.</p>

<form method="POST" action="/login/mfa" class="space-y-4">
<input type="hidden" name="return_to" value="/device?user_code=ABCD-EFGH">
<div>
<label for="code" class="block text-sm font-medium mb-1">Authentication code</label>
<input type="text" id="code" name="code" required autofocus autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm tracking-widest text-center focus:outline-none focus:ring-2 focus:ring-gray-900" placeholder="000000">
</div>
<button type="submit" class="w-full py-2 bg-gray-900 text-white rounded-md font-medium hover:bg-gray-800">
        Verify
      </button>
</form>
<p class="mt-6 text-center text-sm text-gray-500">
<a href="/login" class="text-gray-700 hover:underline">&larr; Back to sign in</a>
</p>
</section>
</main>

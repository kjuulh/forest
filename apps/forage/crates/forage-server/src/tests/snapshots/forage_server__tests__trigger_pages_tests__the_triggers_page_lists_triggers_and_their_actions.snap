</form>
<form method="post" action="/orgs/testorg/projects/my-api/settings/triggers/11111111-2222-3333-4444-555555555555/delete" data-confirm="Delete trigger &quot;main-to-dev&quot;?">
<input type="hidden" name="csrf_token" value="test-csrf">
<button type="submit" class="text-xs px-2.5 py-1 rounded border border-red-300 text-red-600 hover:bg-red-50">Delete</button>
</form>
</div>
</div></div><div class="border border-gray-200 rounded-lg overflow-hidden"><div class="px-4 py-3 flex items-center gap-3 flex-wrap">

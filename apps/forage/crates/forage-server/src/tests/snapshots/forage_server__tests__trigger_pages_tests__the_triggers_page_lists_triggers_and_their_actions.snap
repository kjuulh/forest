</div></div>
</div>
<div class="border border-gray-200 rounded-lg p-6"><h2 class="text-lg font-semibold mb-4">Create Trigger</h2>
<form method="post" action="/orgs/testorg/projects/my-api/settings/triggers" class="space-y-4" id="trigger-form">
<input type="hidden" name="csrf_token" value="test-csrf">
<input type="hidden" name="name" id="trigger-name-hidden" value="">
<p class="text-sm text-gray-500 mb-2">Add at least one filter pattern. Artifacts matching <strong>all</strong> patterns will be auto-released.</p>
<div class="space-y-3" id="pattern-rows"></div>
<button type="button" id="add-pattern-btn" class="text-sm text-gray-500 hover:text-gray-900 flex items-center gap-1">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add filter
          </button>
<hr class="border-gray-200">
<div>
<label class="block text-sm font-medium text-gray-700 mb-2">Target environments</label>
<div class="flex flex-wrap gap-2">
<label class="inline-flex items-center gap-1.5 text-sm border border-gray-200 rounded-md px-3 py-1.5 cursor-pointer hover:bg-gray-50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
<input type="checkbox" name="target_environments" value="dev" class="rounded border-gray-300 text-blue-600">
dev
</label><label class="inline-flex items-center gap-1.5 text-sm border border-gray-200 rounded-md px-3 py-1.5 cursor-pointer hover:bg-gray-50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
<input type="checkbox" name="target_environments" value="prod" class="rounded border-gray-300 text-blue-600">
prod
</label>
</div>
</div>
<div>
<div class="mb-2"><div class="flex items-center gap-2">
<input type="checkbox" id="use-pipeline" name="use_pipeline" value="true" class="rounded border-gray-300">
<label for="use-pipeline" class="text-sm font-medium text-gray-700">Use release pipeline</label>
</div></div>
<div id="pipeline-select-row" class="ml-6 hidden">
<p class="text-xs text-gray-500 mb-1">Releases matching this trigger will use the selected pipeline's deployment stages.</p>
</div>
</div>
<div class="flex items-center gap-2">
<input type="checkbox" id="force-release" name="force_release" value="true" class="rounded border-gray-300">
<label for="force-release" class="text-sm text-gray-700">Force release (skip queue)</label>
</div>
<div class="flex items-center gap-2 text-sm text-gray-500">
<span>Name:</span>
<span id="trigger-name-preview" class="font-mono text-gray-700"></span>
</div>
<button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm hover:bg-gray-800 transition-colors">Create Trigger</button>
</form></div>
</div>
</div>
</section>
</main>

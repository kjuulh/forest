<h2 class="text-lg font-bold">Triggers</h2>
<p class="text-sm text-gray-500 mt-1">Automatically release artifacts matching these rules</p>
</div>
<div class="space-y-3 mb-8">
<div class="border border-gray-200 rounded-lg overflow-hidden"><div class="px-4 py-3 flex items-center gap-3 flex-wrap">
<div class="flex items-center gap-2 min-w-0 flex-1">
<span class="inline-block w-2.5 h-2.5 rounded-full bg-green-500 shrink-0" title="Enabled"></span>
<span class="font-medium text-gray-900">main-to-dev</span>
</div>

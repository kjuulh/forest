---
source: crates/forage-server/src/tests/org_pages_tests.rs
expression: masked_main(&html)
---
<main class="flex-1 pb-16">
<section class="app-container pt-12">
<h1 class="text-2xl font-bold mb-8">Settings</h1>
<nav class="md:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-none" aria-label="Organisation settings sections">
<ul class="flex gap-1.5 w-max">
<li><a href="/orgs/testorg/settings" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">General</a></li><li><a href="/orgs/testorg/settings/members" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Members</a></li><li><a href="/orgs/testorg/settings/integrations" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Integrations</a></li><li><a href="/orgs/testorg/settings/access" aria-current="page" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border bg-gray-100 border-gray-300 text-gray-900 font-medium">Access</a></li><li><a href="/orgs/testorg/settings/visibility" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Visibility</a></li><li><a href="/orgs/testorg/settings/rules" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Rules</a></li><li><a href="/orgs/testorg/settings/developers" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Developer settings</a></li>
</ul>
</nav>
<div class="flex gap-8">
<nav class="w-48 shrink-0 hidden md:block" aria-label="Organisation settings sections">
<ul class="space-y-0.5">
<li><a href="/orgs/testorg/settings" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">General</a></li><li><a href="/orgs/testorg/settings/members" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Members</a></li><li><a href="/orgs/testorg/settings/integrations" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Integrations</a></li><li><a href="/orgs/testorg/settings/access" aria-current="page" class="block px-3 py-1.5 text-sm rounded-md bg-gray-100 text-gray-900 font-medium">Access</a></li><li><a href="/orgs/testorg/settings/visibility" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Visibility</a></li><li><a href="/orgs/testorg/settings/rules" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Rules</a></li><li><a href="/orgs/testorg/settings/developers" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Developer settings</a></li>
</ul>
</nav>
<div class="flex-1 min-w-0">
<div class="space-y-8">
<div>
<h2 class="text-lg font-bold mb-2">Auto-invite by email domain</h2>
<p class="text-sm text-gray-600 mb-4">
          Anyone signing up with a verified email at a domain listed
          below — <strong>and which has passed DNS ownership
          verification</strong> — will see a one-click invite to join
          <strong>testorg</strong>. Unverified domains are
          accepted into the list but grant nothing until DNS proves
          you control them.
        </p>


<form method="POST" action="/orgs/testorg/settings/access" class="flex gap-2 mb-6">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="text" name="domain" placeholder="example.com" required class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-400">
<button type="submit" class="px-4 py-2 text-sm font-medium bg-gray-900 text-white rounded-md hover:bg-gray-800">Add domain</button>
</form>
<div class="space-y-3">
<div class="border border-gray-200 rounded-lg p-4">
<div class="flex items-center justify-between mb-2">
<div class="flex items-center gap-3">
<span class="font-mono text-gray-900">understory.io</span>
<span class="px-2 py-0.5 text-xs rounded-full bg-yellow-100 text-yellow-800">Awaiting verification</span>
</div>
<form method="POST" action="/orgs/testorg/settings/access/remove" class="inline">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="domain" value="understory.io">
<button type="submit" class="text-sm text-red-600 hover:text-red-800">Remove</button>
</form>
</div>
<div class="mt-2 text-sm text-gray-700">
<p class="mb-2">Publish this TXT record, then click Verify:</p>
<div class="bg-gray-50 border border-gray-200 rounded-md px-3 py-2 font-mono text-xs overflow-x-auto">
<div>name: <span class="text-gray-900">_forest-verify.understory.io</span></div>
<div>type: <span class="text-gray-900">TXT</span></div>
<div>value: <span class="text-gray-900">tok-abc123</span></div>
</div>
<form method="POST" action="/orgs/testorg/settings/access/verify" class="mt-3">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="domain" value="understory.io">
<button type="submit" class="px-3 py-1.5 text-sm font-medium bg-gray-900 text-white rounded-md hover:bg-gray-800">Verify DNS</button>
</form>
</div>
</div><div class="border border-gray-200 rounded-lg p-4">
<div class="flex items-center justify-between mb-2">
<div class="flex items-center gap-3">
<span class="font-mono text-gray-900">verified.example</span>
<span class="px-2 py-0.5 text-xs rounded-full bg-green-100 text-green-800">DNS verified</span>
</div>
<form method="POST" action="/orgs/testorg/settings/access/remove" class="inline">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="domain" value="verified.example">
<button type="submit" class="text-sm text-red-600 hover:text-red-800">Remove</button>
</form>
</div>

</div>
</div>
</div>
</div>
</div>
</div>
</section>
</main>

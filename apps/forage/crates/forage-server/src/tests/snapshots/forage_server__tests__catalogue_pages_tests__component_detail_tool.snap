</div>
<div class="flex items-center justify-between">
<dt class="text-xs text-gray-500 uppercase tracking-wide">Archive</dt>
<dd><span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-700">tar.gz</span></dd>
</div>

<div class="flex items-center justify-between gap-3">
<dt class="text-xs text-gray-500 uppercase tracking-wide shrink-0">Archive sha256</dt>
<dd class="font-mono text-xs text-gray-700" title="sha256:5df1c9aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaec945">5df1c9…ec945</dd>
</div>
</dl>
</div>


---
source: crates/forage-server/src/tests/account_pages_tests.rs
expression: masked_main(html)
---
<main class="flex-1 pb-16">
<section class="app-container py-12">
<div class="flex items-center justify-between mb-8">
<h1 class="text-2xl font-bold">Account Settings</h1>
<a href="/orgs/testorg/projects" class="text-sm text-gray-500 hover:text-gray-700">&larr; testorg</a>
</div>



<div class="mb-12">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Profile picture</h2>
<div class="flex items-center gap-6">
<div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center text-2xl font-bold text-gray-500 shrink-0">T</div>
<div class="flex flex-col gap-2">
<form method="POST" action="/settings/account/picture" enctype="multipart/form-data" class="flex items-center gap-2">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="file" name="picture" accept="image/jpeg,image/png,image/webp" class="text-sm text-gray-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border file:border-gray-300 file:text-sm file:bg-white file:text-gray-700 hover:file:bg-gray-50">
<button type="submit" class="px-4 py-1.5 text-sm bg-gray-900 text-white rounded-md hover:bg-gray-800 whitespace-nowrap">Upload</button>
</form>

<p class="text-xs text-gray-400">JPEG, PNG, or WebP. Max 2 MB.</p>
</div>
</div>
</div>
<div class="mb-12">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Username</h2>
<form method="POST" action="/settings/account/username" class="flex gap-2">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="text" name="username" value="testuser" class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
<button type="submit" class="px-4 py-2 text-sm bg-gray-900 text-white rounded-md hover:bg-gray-800 whitespace-nowrap">Update</button>
</form>
</div>
<div class="mb-12">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Email addresses</h2>
<div class="space-y-2 mb-4">
<div class="flex items-center justify-between px-4 py-3 border border-gray-200 rounded-lg">
<div class="flex items-center gap-2">
<span class="text-sm text-gray-900">test@example.com</span>
<span class="text-xs text-green-700 bg-green-100 px-1.5 py-0.5 rounded">verified</span>
</div>
<div class="flex items-center gap-3">

<form method="POST" action="/settings/account/emails/remove">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="email" value="test@example.com">
<button type="submit" class="text-xs text-red-600 hover:text-red-800">Remove</button>
</form>
</div>
</div>
</div>
<form method="POST" action="/settings/account/emails" class="flex gap-2">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="email" name="email" placeholder="new@example.com" class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
<button type="submit" class="px-4 py-2 text-sm bg-gray-900 text-white rounded-md hover:bg-gray-800 whitespace-nowrap">Add email</button>
</form>
</div>
<div class="mb-12">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Change password</h2>
<form method="POST" action="/settings/account/password" class="space-y-3">
<input type="hidden" name="_csrf" value="test-csrf">
<div>
<label for="current-password" class="block text-sm text-gray-700 mb-1">Current password</label>
<input type="password" id="current-password" name="current_password" required autocomplete="current-password" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
</div>
<div>
<label for="new-password" class="block text-sm text-gray-700 mb-1">New password</label>
<input type="password" id="new-password" name="new_password" required autocomplete="new-password" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
</div>
<div>
<label for="new-password-confirm" class="block text-sm text-gray-700 mb-1">Confirm new password</label>
<input type="password" id="new-password-confirm" name="new_password_confirm" required autocomplete="new-password" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
</div>
<button type="submit" class="px-4 py-2 text-sm bg-gray-900 text-white rounded-md hover:bg-gray-800">Change password</button>
</form>
</div>
<div class="mb-12">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Two-factor authentication</h2>
<p class="text-sm text-gray-500 mb-4">Add an extra layer of security to your account by requiring a code from your authenticator app when you sign in.</p>
<form method="POST" action="/settings/account/mfa/setup">
<input type="hidden" name="_csrf" value="test-csrf">
<button type="submit" class="px-4 py-2 text-sm bg-gray-900 text-white rounded-md hover:bg-gray-800">Enable two-factor authentication</button>
</form>
</div>
<div class="mb-12">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Linked accounts</h2>
<p class="text-sm text-gray-500 mb-4">Link external identities so we can map your work to your account. Disconnecting a sign-in provider won't log you out of this session. If it's the only way you sign in, we'll block the disconnect — set a password or link another provider first.</p>
<div class="space-y-2 mb-4">
<div class="flex items-center justify-between px-4 py-3 border border-gray-200 rounded-lg">
<div class="flex items-center gap-3">
<div class="w-8 h-8 bg-gray-900 rounded flex items-center justify-center flex-shrink-0"><svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg></div>
<div>
<p class="text-sm font-medium text-gray-900">GitHub</p>
<p class="text-xs text-gray-500">kjuulh · kasper@example.com</p>
</div>
</div>
<form method="POST" action="/settings/account/github/disconnect" data-confirm="Disconnect this GitHub account?">
<input type="hidden" name="_csrf" value="test-csrf">
<button type="submit" class="text-xs text-red-600 hover:text-red-800">Disconnect</button>
</form>
</div>
</div>
<div class="flex flex-wrap gap-2">

<a href="/settings/account/google/connect" class="inline-flex items-center gap-2 px-4 py-2 text-sm border border-gray-300 rounded-md hover:bg-gray-50 text-gray-700">
<svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path></svg>
              Link Google
            </a>

</div>
</div>

<div class="mb-12">
<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">CLI notifications</h2>
<p class="text-sm text-gray-500 mb-4">Choose which events appear in your CLI notification feed.</p>
<div class="border border-gray-200 rounded-lg overflow-hidden">
<table class="w-full text-sm">
<thead>
<tr class="bg-gray-50 border-b border-gray-200">
<th class="text-left px-4 py-3 font-medium text-gray-700">Event</th>
<th class="text-center px-4 py-3 font-medium text-gray-700 w-24">CLI</th>
</tr>
</thead>
<tbody class="divide-y divide-gray-100">
<tr>
<td class="px-4 py-3 text-gray-700">Release annotated</td>
<td class="text-center px-4 py-3">
<form method="POST" action="/settings/account/notifications" class="inline">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="notification_type" value="NOTIFICATION_TYPE_RELEASE_ANNOTATED">
<input type="hidden" name="channel" value="NOTIFICATION_CHANNEL_CLI">
<input type="hidden" name="enabled" value="true">
<button type="submit" class="w-8 h-5 rounded-full relative transition-colors bg-gray-300" title="Enable release annotated via CLI" aria-pressed="false">
<span class="block w-3.5 h-3.5 rounded-full bg-white shadow-sm absolute top-0.5 transition-all left-0.5"></span>
</button>
</form>
</td>
</tr><tr>
<td class="px-4 py-3 text-gray-700">Release started</td>
<td class="text-center px-4 py-3">
<form method="POST" action="/settings/account/notifications" class="inline">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="notification_type" value="NOTIFICATION_TYPE_RELEASE_STARTED">
<input type="hidden" name="channel" value="NOTIFICATION_CHANNEL_CLI">
<input type="hidden" name="enabled" value="true">
<button type="submit" class="w-8 h-5 rounded-full relative transition-colors bg-gray-300" title="Enable release started via CLI" aria-pressed="false">
<span class="block w-3.5 h-3.5 rounded-full bg-white shadow-sm absolute top-0.5 transition-all left-0.5"></span>
</button>
</form>
</td>
</tr><tr>
<td class="px-4 py-3 text-gray-700">Release succeeded</td>
<td class="text-center px-4 py-3">
<form method="POST" action="/settings/account/notifications" class="inline">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="notification_type" value="NOTIFICATION_TYPE_RELEASE_SUCCEEDED">
<input type="hidden" name="channel" value="NOTIFICATION_CHANNEL_CLI">
<input type="hidden" name="enabled" value="true">
<button type="submit" class="w-8 h-5 rounded-full relative transition-colors bg-gray-300" title="Enable release succeeded via CLI" aria-pressed="false">
<span class="block w-3.5 h-3.5 rounded-full bg-white shadow-sm absolute top-0.5 transition-all left-0.5"></span>
</button>
</form>
</td>
</tr><tr>
<td class="px-4 py-3 text-gray-700">Release failed</td>
<td class="text-center px-4 py-3">
<form method="POST" action="/settings/account/notifications" class="inline">
<input type="hidden" name="_csrf" value="test-csrf">
<input type="hidden" name="notification_type" value="NOTIFICATION_TYPE_RELEASE_FAILED">
<input type="hidden" name="channel" value="NOTIFICATION_CHANNEL_CLI">
<input type="hidden" name="enabled" value="false">
<button type="submit" class="w-8 h-5 rounded-full relative transition-colors bg-gray-900" title="Disable release failed via CLI" aria-pressed="true">
<span class="block w-3.5 h-3.5 rounded-full bg-white shadow-sm absolute top-0.5 transition-all left-[calc(100%-1.125rem)]"></span>
</button>
</form>
</td>
</tr>
</tbody>
</table>
</div>
</div>
</section>
</main>

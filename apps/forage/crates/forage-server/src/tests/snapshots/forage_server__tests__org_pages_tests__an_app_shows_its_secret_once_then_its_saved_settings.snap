---
source: crates/forage-server/src/tests/org_pages_tests.rs
expression: masked_main(&html)
---
<main class="flex-1 pb-16">
<section class="app-container pt-12">
<h1 class="text-2xl font-bold mb-8">Settings</h1>
<nav class="md:hidden -mx-4 px-4 mb-6 overflow-x-auto scrollbar-none" aria-label="Organisation settings sections">
<ul class="flex gap-1.5 w-max">
<li><a href="/orgs/testorg/settings" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">General</a></li><li><a href="/orgs/testorg/settings/members" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Members</a></li><li><a href="/orgs/testorg/settings/integrations" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Integrations</a></li><li><a href="/orgs/testorg/settings/access" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Access</a></li><li><a href="/orgs/testorg/settings/visibility" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Visibility</a></li><li><a href="/orgs/testorg/settings/rules" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border border-gray-200 text-gray-600 hover:text-gray-900 hover:bg-gray-50">Rules</a></li><li><a href="/orgs/testorg/settings/developers" aria-current="page" class="block whitespace-nowrap px-3 py-1.5 text-sm rounded-md border bg-gray-100 border-gray-300 text-gray-900 font-medium">Developer settings</a></li>
</ul>
</nav>
<div class="flex gap-8">
<nav class="w-48 shrink-0 hidden md:block" aria-label="Organisation settings sections">
<ul class="space-y-0.5">
<li><a href="/orgs/testorg/settings" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">General</a></li><li><a href="/orgs/testorg/settings/members" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Members</a></li><li><a href="/orgs/testorg/settings/integrations" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Integrations</a></li><li><a href="/orgs/testorg/settings/access" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Access</a></li><li><a href="/orgs/testorg/settings/visibility" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Visibility</a></li><li><a href="/orgs/testorg/settings/rules" class="block px-3 py-1.5 text-sm rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-50">Rules</a></li><li><a href="/orgs/testorg/settings/developers" aria-current="page" class="block px-3 py-1.5 text-sm rounded-md bg-gray-100 text-gray-900 font-medium">Developer settings</a></li>
</ul>
</nav>
<div class="flex-1 min-w-0">
<div class="mb-8">
<a href="/orgs/testorg/settings/developers" class="text-sm text-gray-500 hover:text-gray-900">← Developer settings</a>
<h2 class="text-lg font-bold mt-2">My App</h2>
</div>


<div class="mb-8 max-w-xl">
<label class="block text-sm font-medium text-gray-700 mb-1">Client ID</label>
<code class="block w-full px-3 py-2 text-sm font-mono bg-gray-50 border border-gray-200 rounded select-all break-all">forest_oa_app-1</code>
</div>
<form method="POST" action="/orgs/testorg/settings/developers/app-1" class="space-y-6 max-w-xl">
<input type="hidden" name="_csrf" value="test-csrf">
<div>
<label class="block text-sm font-medium text-gray-700 mb-1" for="name">Application name</label>
<input id="name" name="name" type="text" required maxlength="100" value="My App" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
</div>
<div>
<label class="block text-sm font-medium text-gray-700 mb-1" for="description">Description</label>
<input id="description" name="description" type="text" value="" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
</div>
<div>
<label class="block text-sm font-medium text-gray-700 mb-1" for="homepage_url">Homepage URL</label>
<input id="homepage_url" name="homepage_url" type="url" value="" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">
</div>
<div>
<label class="block text-sm font-medium text-gray-700 mb-1" for="redirect_uris">Redirect URIs</label>
<p class="text-xs text-gray-500 mb-1">One per line.</p>
<textarea id="redirect_uris" name="redirect_uris" rows="3" required class="w-full px-3 py-2 text-sm font-mono border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900">https://a.example/cb
https://b.example/cb</textarea>
</div>
<fieldset>
<legend class="block text-sm font-medium text-gray-700 mb-1">Scopes</legend>
<div class="space-y-2">
<label class="flex items-start gap-2">
<input type="checkbox" name="scope_openid" class="mt-0.5">
<span class="text-sm"><span class="font-mono">openid</span> — OpenID Connect sign-in (issues an ID token)</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="scope_profile" class="mt-0.5">
<span class="text-sm"><span class="font-mono">profile</span> — username, user ID and avatar</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="scope_email" checked class="mt-0.5">
<span class="text-sm"><span class="font-mono">email</span> — verified email addresses</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="scope_components_publish" class="mt-0.5">
<span class="text-sm"><span class="font-mono">components:publish</span> — publish Forest components from CI</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="scope_tokens_introspect" class="mt-0.5">
<span class="text-sm"><span class="font-mono">tokens:introspect</span> — check other apps’ tokens (a service that accepts them)</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="scope_datagateway_apply" class="mt-0.5">
<span class="text-sm"><span class="font-mono">datagateway:apply</span> — define data gateway project metrics</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="scope_datagateway_read" class="mt-0.5">
<span class="text-sm"><span class="font-mono">datagateway:read</span> — query data gateway project metrics</span>
</label>
</div>
</fieldset>
<fieldset>
<legend class="block text-sm font-medium text-gray-700 mb-1">Grant types</legend>
<p class="text-xs text-gray-500 mb-2">How the app authenticates. An app may use both. Removing a grant takes effect immediately — in-flight authorization codes and existing refresh tokens for that flow stop working.</p>
<div class="space-y-2">
<label class="flex items-start gap-2">
<input type="checkbox" name="grant_authorization_code" class="mt-0.5">
<span class="text-sm"><span class="font-mono">authorization_code</span> — “Sign in with Forest”, on behalf of a user</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="grant_client_credentials" checked class="mt-0.5">
<span class="text-sm"><span class="font-mono">client_credentials</span> — a service calling as itself, with no user involved</span>
</label><label class="flex items-start gap-2">
<input type="checkbox" name="grant_device_code" class="mt-0.5">
<span class="text-sm"><span class="font-mono">device_code</span> — a CLI signs a user in with a code they approve on another device (RFC 8628)</span>
</label>
</div>
</fieldset>
<button type="submit" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800">Save changes</button>
</form>
<div class="mt-12 pt-8 border-t border-gray-200 max-w-xl space-y-4">
<div class="flex items-center justify-between gap-4">
<div>
<p class="text-sm font-medium text-gray-900">Rotate client secret</p>
<p class="text-xs text-gray-500">Invalidates the current secret and generates a new one.</p>
</div>
<form method="POST" action="/orgs/testorg/settings/developers/app-1/rotate">
<input type="hidden" name="_csrf" value="test-csrf">
<button type="submit" class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50">Rotate secret</button>
</form>
</div>
<div class="flex items-center justify-between gap-4">
<div>
<p class="text-sm font-medium text-red-700">Delete this application</p>
<p class="text-xs text-gray-500">Revokes all tokens issued by this app. This cannot be undone.</p>
</div>
<form method="POST" action="/orgs/testorg/settings/developers/app-1/delete" data-confirm="Delete this OAuth application? All issued tokens will stop working.">
<input type="hidden" name="_csrf" value="test-csrf">
<button type="submit" class="inline-flex items-center px-3 py-2 text-sm font-medium text-red-700 border border-red-300 rounded-md hover:bg-red-50">Delete</button>
</form>
</div>
</div>
</div>
</div>
</section>
</main>

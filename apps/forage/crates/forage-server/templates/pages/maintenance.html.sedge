props crate::views::catalogue::MaintenancePage { css_href };

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maintenance - Forest</title>
  <meta name="description" content="Forest is temporarily unavailable while maintenance is in progress.">
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href={css_href}>
</head>
<body class="maintenance">
  <main class="maintenance-card">
    <p class="maintenance-wordmark">forest</p>
    <p class="maintenance-status">Maintenance in progress</p>
    <h1 class="maintenance-heading">We&rsquo;ll be back shortly.</h1>
    <p class="maintenance-message">The entire application is temporarily unavailable while we carry out maintenance.</p>
    <p class="maintenance-retry">Please try again in a few minutes.</p>
  </main>
</body>
</html>

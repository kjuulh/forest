use forage_ui::components::Alert;
use forage_ui::layouts::Shell;
props crate::views::auth::MagicLinkPage { chrome, email, error, return_to };

<Shell chrome={chrome}>
  <section class="max-w-md mx-auto px-4 pt-24">
    <h1 class="text-2xl font-bold text-center mb-2">Sign in with email</h1>
    <p class="text-center text-gray-600 mb-8">We'll send you a magic link to sign in instantly.</p>

    {if let Some(error) = error {
      <Alert>{error}</Alert>
    }}

    <form method="POST" action="/auth/magic-link" class="space-y-4">
      {if let Some(rt) = return_to { <input type="hidden" name="return_to" value={rt}> }}
      <div>
        <label for="email" class="block text-sm font-medium mb-1">Email</label>
        <input type="email" id="email" name="email" value={email} required
          class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
          placeholder="alice@example.com">
      </div>

      <button type="submit" class="w-full py-2 bg-gray-900 text-white rounded-md font-medium hover:bg-gray-800">
        Send magic link
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-gray-600">
      <a href="/login" class="font-medium text-gray-900 hover:underline">Back to sign in</a>
    </p>
  </section>
</Shell>

use forage_ui::AlertKind;
use forage_ui::components::{BackToIntegrations, CsrfField, Flash, InstallField, IntegrationIcon, IntegrationLogo, Step, Steps};
use forage_ui::layouts::Shell;
use crate::views::org_settings::{integrations_href, message};
props crate::views::org_settings::InstallSlackPage { chrome, org, csrf_token, error, has_slack_oauth };

<Shell chrome={chrome}>
  <section class="max-w-2xl mx-auto px-4 py-12">
    <BackToIntegrations org={org} />
    <div class="flex items-start gap-4 mb-8">
      <IntegrationLogo kind="slack" box_class="w-14 h-14" icon_class="w-7 h-7 text-gray-600" />
      <div>
        <h1 class="text-2xl font-bold">Install Slack</h1>
        <p class="text-sm text-gray-500 mt-1">Post deployment notifications directly to Slack channels from <strong>{org}</strong>.</p>
      </div>
    </div>
    {if let Some(error) = message(error) { <Flash kind={AlertKind::Error}>{error}</Flash> }}
    <Steps title="How it works">
      <Step n={1}>Rich Block Kit messages with release metadata, status badges, and color-coded sidebars</Step>
      <Step n={2}>Notifications include organisation, project, destination, commit, branch, and author</Step>
      <Step n={3}>Configure which events trigger notifications (releases started, succeeded, failed, annotated)</Step>
      <Step n={4}>Failed deliveries are retried up to 3 times with exponential backoff</Step>
    </Steps>
    {if *has_slack_oauth {
      <div class="mb-8">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Connect with Slack</h3>
        <p class="text-sm text-gray-500 mb-4">Click the button below to authorize Forest to post to a Slack channel. You'll choose which channel during the Slack authorization flow.</p>
        <form method="POST" action="{integrations_href(org)}/install/slack/start">
          <CsrfField token={csrf_token} name="_csrf" />
          <button type="submit" class="inline-flex items-center gap-3 px-5 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium text-sm">
            <IntegrationIcon kind="slack" class="w-5 h-5" />
            Add to Slack
          </button>
        </form>
      </div>
      <div class="relative my-8">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200"></div></div>
        <div class="relative flex justify-center text-sm"><span class="px-3 bg-white text-gray-400">or use a webhook URL</span></div>
      </div>
    }}
    <form method="POST" action="{integrations_href(org)}/slack" class="space-y-5">
      <CsrfField token={csrf_token} name="_csrf" />
      {if *has_slack_oauth {
        <p class="text-sm text-gray-500 mb-2">Alternatively, paste a Slack Incoming Webhook URL directly. Create one in your <a href="https://api.slack.com/apps" target="_blank" rel="noopener" class="text-gray-700 underline hover:text-gray-900">Slack App settings</a>.</p>
      } else {
        <p class="text-sm text-gray-500 mb-2">Paste a Slack Incoming Webhook URL. Create one in your <a href="https://api.slack.com/apps" target="_blank" rel="noopener" class="text-gray-700 underline hover:text-gray-900">Slack App settings</a> under <strong>Incoming Webhooks</strong>.</p>
      }}
      <InstallField name="name" label="Name" placeholder="e.g. #deploys" required={true}>
        <:hint>A friendly name to identify this integration</:hint>
      </InstallField>
      <InstallField name="webhook_url" label="Webhook URL" kind="url" placeholder="https://hooks.slack.com/services/T.../B.../..." required={true} mono={true}>
        <:hint>Must be a <code class="bg-gray-200 px-1 py-0.5 rounded">https://hooks.slack.com/</code> URL</:hint>
      </InstallField>
      <InstallField name="channel_name" label="Channel name" placeholder="#deploys" optional={true}>
        <:hint>For display purposes only (defaults to #general)</:hint>
      </InstallField>
      <div class="pt-2">
        <button type="submit" class="w-full px-4 py-2.5 text-sm font-medium bg-gray-900 text-white rounded-md hover:bg-gray-800 transition-colors">Install Slack integration</button>
      </div>
    </form>
  </section>
</Shell>

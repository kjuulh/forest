use forage_ui::AlertKind;
use forage_ui::components::{BackToIntegrations, CsrfField, Flash, InstallField, IntegrationLogo, Step, Steps};
use forage_ui::layouts::Shell;
use crate::views::org_settings::{integrations_href, message};
props crate::views::org_settings::InstallWebhookPage { chrome, org, csrf_token, error };

<Shell chrome={chrome}>
  <section class="max-w-2xl mx-auto px-4 py-12">
    <BackToIntegrations org={org} />
    <div class="flex items-start gap-4 mb-8">
      <IntegrationLogo kind="webhook" box_class="w-14 h-14" icon_class="w-7 h-7 text-gray-600" />
      <div>
        <h1 class="text-2xl font-bold">Install Webhook</h1>
        <p class="text-sm text-gray-500 mt-1">Send HTTP POST requests to your endpoint when deployment events occur in <strong>{org}</strong>.</p>
      </div>
    </div>
    {if let Some(error) = message(error) { <Flash kind={AlertKind::Error}>{error}</Flash> }}
    <Steps title="How it works">
      <Step n={1}>Forest sends a <code class="text-xs bg-gray-200 px-1 py-0.5 rounded">POST</code> request with a JSON payload to your URL</Step>
      <Step n={2}>Payloads include event type, release metadata, project, and organisation</Step>
      <Step n={3}>Optional HMAC-SHA256 signing via <code class="text-xs bg-gray-200 px-1 py-0.5 rounded">X-Forest-Signature</code> header</Step>
      <Step n={4}>Failed deliveries are retried up to 3 times with exponential backoff</Step>
    </Steps>
    <form method="POST" action="{integrations_href(org)}/webhook" class="space-y-5">
      <CsrfField token={csrf_token} name="_csrf" />
      <InstallField name="name" label="Name" placeholder="e.g. Production alerts" required={true}>
        <:hint>A friendly name to identify this webhook</:hint>
      </InstallField>
      <InstallField name="url" label="Payload URL" kind="url" placeholder="https://example.com/webhooks/forage" required={true} mono={true}>
        <:hint>Must use HTTPS (HTTP allowed for localhost only)</:hint>
      </InstallField>
      <InstallField name="secret" label="Secret" placeholder="whsec_..." optional={true} mono={true}>
        <:hint>Used to compute <code class="bg-gray-200 px-1 py-0.5 rounded">X-Forest-Signature</code> (HMAC-SHA256) so you can verify payloads are from Forest</:hint>
      </InstallField>
      <div class="pt-2">
        <button type="submit" class="w-full px-4 py-2.5 text-sm font-medium bg-gray-900 text-white rounded-md hover:bg-gray-800 transition-colors">Install webhook</button>
      </div>
    </form>
  </section>
</Shell>

use forage_ui::components::Icon;
use forage_ui::layouts::Shell;
use crate::views::projects::project_href;
props crate::views::projects::ProjectsPage { chrome, org, projects, filter_js };

<Shell chrome={chrome}>
  <section class="app-container pt-12">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold">Projects</h1>
    </div>
    {if projects.len() > 5 {
      <div class="mb-6">
        <input type="text" id="project-filter" placeholder="Filter projects..." class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900" data-project-filter>
      </div>
    }}
    {if !projects.is_empty() {
      <div class="space-y-2" id="project-list">
        {for project in projects.iter() {
          <a href={project_href(org, project)} class="project-card flex items-center justify-between px-5 py-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-colors" data-name={project}>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded bg-gray-100 flex items-center justify-center shrink-0">
                <Icon name="folder" class="w-4 h-4 text-gray-400" />
              </div>
              <span class="font-medium">{project}</span>
            </div>
            <Icon name="chevron-right" class="w-4 h-4 text-gray-300" />
          </a>
        }}
      </div>
    } else {
      <div class="p-8 border border-gray-200 rounded-lg text-center">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        <p class="text-gray-600 font-medium">No projects yet</p>
        <p class="text-sm text-gray-400 mt-2 max-w-md mx-auto">Projects are created automatically when you deploy. Install the forest CLI and run your first release.</p>
        <div class="bg-gray-950 rounded-md p-4 text-sm font-mono text-gray-300 text-left max-w-sm mx-auto mt-4">
          <pre><span class="text-gray-500"># Install and deploy</span>
forest init my-project
forest release create --env dev</pre>
        </div>
      </div>
    }}
  </section>
  <:scripts>
    {if projects.len() > 5 { <script src={filter_js} defer></script> }}
  </:scripts>
</Shell>

use forage_ui::components::{Icon, Step, Steps};
use forage_ui::layouts::Shell;
use crate::views::org_settings::{integration_href, integrations_href};
props crate::views::org_settings::IntegrationInstalledPage { chrome, org, id, name, type_display, api_token };

<Shell chrome={chrome}>
  <section class="max-w-2xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-50 mb-4">
        <Icon name="check" class="w-8 h-8 text-green-600" />
      </div>
      <h1 class="text-2xl font-bold">{type_display} installed</h1>
      <p class="text-sm text-gray-500 mt-1"><strong>{name}</strong> is now active in {org}.</p>
    </div>
    {if let Some(token) = api_token.as_deref().filter(|t| !t.is_empty()) {
      <div class="mb-8 p-5 bg-amber-50 border border-amber-200 rounded-lg">
        <div class="flex items-start gap-3">
          <Icon name="warning" class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
          <div class="min-w-0 flex-1">
            <h3 class="text-sm font-semibold text-amber-800 mb-1">API Token</h3>
            <p class="text-sm text-amber-700 mb-3">This token allows the integration to query the Forest API. Copy it now — it won't be shown again.</p>
            <div class="relative">
              <code id="api-token" class="block w-full px-3 py-2 text-sm font-mono bg-white border border-amber-300 rounded-md text-gray-900 break-all select-all">{token}</code>
              <button type="button" data-copy="api-token" class="absolute top-1.5 right-1.5 px-2 py-1 text-xs bg-amber-100 text-amber-700 rounded hover:bg-amber-200 transition-colors">Copy</button>
            </div>
          </div>
        </div>
      </div>
    }}
    <Steps title="What's next">
      <Step n={1}>Configure which events trigger notifications on the integration settings page</Step>
      <Step n={2}>Use the API token to query releases, projects, and notifications from your service</Step>
      <Step n={3}>Send a test event to verify your endpoint receives payloads correctly</Step>
    </Steps>
    <div class="flex gap-3">
      <a href={integration_href(org, id)} class="flex-1 text-center px-4 py-2.5 text-sm font-medium bg-gray-900 text-white rounded-md hover:bg-gray-800 transition-colors">Configure integration</a>
      <a href={integrations_href(org)} class="flex-1 text-center px-4 py-2.5 text-sm font-medium border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">Back to integrations</a>
    </div>
  </section>
</Shell>

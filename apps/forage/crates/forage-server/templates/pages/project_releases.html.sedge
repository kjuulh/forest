use forage_ui::components::{IconLink, TimelinePrefetch};
use forage_ui::layouts::Shell;
use crate::views::models::settings_href;
props crate::views::models::ProjectReleasesPage { chrome, org, project, csrf_token, username, role, prefetch_js, show_graph, graph_js };

<Shell chrome={chrome}>
  <section class="app-container pt-12">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <h1 class="text-2xl font-bold">{if *show_graph { Graph } else { Releases }}</h1>
      <div class="flex flex-wrap items-center gap-4">
        <IconLink href={settings_href(org, project, "pipelines")} icon="pipelines">Pipelines</IconLink>
        <IconLink href={settings_href(org, project, "triggers")} icon="triggers">Triggers</IconLink>
        <IconLink href={settings_href(org, project, "policies")} icon="policies">Policies</IconLink>
      </div>
    </div>
    <TimelinePrefetch org={org} project={Some(project.as_str())} src={prefetch_js} include_graph={*show_graph} />
    {let view_name = if *show_graph { "graph" } else { "releases" };}
    <release-timeline id="rt-{org}-{project}-{view_name}" sedx-preserve org={org} project={project} csrf={csrf_token} username={username} role={role} graph={if *show_graph { Some("true") } else { None }}></release-timeline>
  </section>
  <:scripts>
    <script src="/static/js/components/forage-components.js?v={chrome.assets.components_js_hash}"></script>
    {if let Some(src) = graph_js {
      <script src={src}></script>
    }}
  </:scripts>
</Shell>
